; Load this file in the VST editor, or export it with --graphics.
CS
SETSCREENCOLOR [16 24 39]
SETPC [46 190 210]
PENSIZE 3

TO TRIANGLE :SIZE
  POLYSTART
  REPEAT 3 [
    FD :SIZE
    RT 120
  ]
  POLYEND
END

SETPOS -110 10
TRIANGLE 90

PENUP
SETX 45
SETY 10
SETH 90
PENDOWN
SETPC [246 190 82]
ELLIPSEARC 360 38 24 0

PENREVERSE
FD 24
PENNORMAL

SETPC [226 103 125]
SETPIXEL [226 103 125]
PIXEL
LABELSIZE 14
SETLABELFONT "sans-serif"
LABEL "Logo command tour"

WRAP
FENCE
WINDOW
SHOWTURTLE
