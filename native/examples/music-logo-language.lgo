; Words, lists, reporter procedures, and Logo-style control flow.

TO TRANSPOSE :PITCH :AMOUNT
  OUTPUT SUM :PITCH :AMOUNT
END

TO SCALE :BASE
  OUTPUT LIST :BASE SUM :BASE 2
END

TO NAME4 :PITCH
  OUTPUT WORD "C :PITCH
END

TO PLAY :PITCH
  NOTE :PITCH 0.25
END

MAKE "MOTIF SENTENCE SCALE 60 [64]
MAKE "VOICES SENTENCE :MOTIF [67 71]
MAKE "VOICES LPUT TRANSPOSE LAST :MOTIF 8 :VOICES
MAKE "NAME NAME4 4

; REPCOUNT is one-based, matching Logo repeat loops.
REPEAT 3 [
  NOTE ITEM REPCOUNT :MOTIF 0.25
]

PLAY FIRST :MOTIF

; WHILE rechecks the condition after each body run.
MAKE "INDEX 0
WHILE [ :INDEX < 2 ] [
  NOTE ITEM SUM :INDEX 1 :MOTIF 0.5
  MAKE "INDEX SUM :INDEX 1
]

UNTIL [ :INDEX >= 3 ] [
  NOTE 67 0.25
  MAKE "INDEX SUM :INDEX 1
]

IFELSE AND MEMBER? 72 :VOICES EQUAL? FIRST :NAME "C [
  NOTE TRANSPOSE FIRST :MOTIF 12 0.5
] [
  REST 0.5
]
