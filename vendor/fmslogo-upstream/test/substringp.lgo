LOAD "testlib.lgo

TO SUBSTRINGPTEST.SMOKETEST
  ; Examples from the manual
  FAILIFNOTTRUE  [ SUBSTRINGP "bc "abc ]
  FAILIFNOTFALSE [ SUBSTRINGP "bd "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "bc "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "bd "abc ]
END


TO SUBSTRINGPTEST.VARIATIONS

  FAILIFNOTFALSE  [ SUBSTRING? [a] "abc      ]
  FAILIFNOTFALSE  [ SUBSTRING? {a} "abc      ]
  FAILIFNOTFALSE  [ SUBSTRING? "a  [a]       ]
  FAILIFNOTFALSE  [ SUBSTRING? "a  {a}       ]
  FAILIFNOTFALSE  [ SUBSTRING? "a  {a}@-100  ]

  ; No explicit ignore case
  LOCAL "CASEIGNOREDP
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "b "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "c "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "d "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "A "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "B "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "b "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "c "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "A "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "B "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "C "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) "ab    ]
  FAILIFNOTFALSE [ SUBSTRING? "a     (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "xxxabcyyy ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "xxxABCyyy ]
  FAILIFNOTFALSE [ SUBSTRING? "abcd "xxxabcyyy ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "abc       ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "ABC       ]

  ; Ignore case explicitly (same result as above)
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "TRUE ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "b "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "c "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "d "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "A "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "B "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "b "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "c "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "A "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "B "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "C "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) "ab    ]
  FAILIFNOTFALSE [ SUBSTRING? "a     (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "xxxabcyyy ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "xxxABCyyy ]
  FAILIFNOTFALSE [ SUBSTRING? "abcd "xxxabcyyy ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "abc       ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "ABC       ]

  ; Case-sensitive
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "FALSE ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "a "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "b "abc ]
  FAILIFNOTTRUE  [ SUBSTRING? "c "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "d "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "A "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "B "abc ]
  FAILIFNOTFALSE [ SUBSTRING? "a "ABC ]
  FAILIFNOTFALSE [ SUBSTRING? "b "ABC ]
  FAILIFNOTFALSE [ SUBSTRING? "c "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "A "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "B "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? "C "ABC ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) "ab    ]
  FAILIFNOTFALSE [ SUBSTRING? "a     (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? (WORD) (WORD) ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "xxxabcyyy ]
  FAILIFNOTFALSE [ SUBSTRING? "abc  "xxxABCyyy ]
  FAILIFNOTFALSE [ SUBSTRING? "abcd "xxxabcyyy ]
  FAILIFNOTTRUE  [ SUBSTRING? "abc  "abc       ]
  FAILIFNOTFALSE [ SUBSTRING? "abc  "ABC       ]

END


TO SUBSTRINGPTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(SUBSTRINGP)]
  RUNNOTENOUGHINPUTSTEST [(SUBSTRINGP "a)]
  RUNTOOMANYINPUTSTEST   [(SUBSTRINGP "a "abc "toomany)]
END


TO SUBSTRINGPTEST
  SUBSTRINGPTEST.SMOKETEST
  SUBSTRINGPTEST.VARIATIONS
  SUBSTRINGPTEST.BADINPUT
END
