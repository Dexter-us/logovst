LOAD "testlib.lgo

TO ASCIITEST.UNICODE

  SIMPLEREPORTTEST [ ASCII "ñ   ] 241 ; Latin-1
  SIMPLEREPORTTEST [ ASCII "Й   ] 1049 ; Cryillic
  SIMPLEREPORTTEST [ ASCII "к   ] 1082 ; Cryillic
  SIMPLEREPORTTEST [ ASCII "ε   ] 949 ; Greek
  SIMPLEREPORTTEST [ ASCII "η   ] 951 ; Greek
  SIMPLEREPORTTEST [ ASCII "汉  ] 27721 ; Simplified Chinese
  SIMPLEREPORTTEST [ ASCII "语  ] 35821 ; Simplified Chinese
  SIMPLEREPORTTEST [ ASCII "漢  ] 28450 ; Traditional Chinese
  SIMPLEREPORTTEST [ ASCII "語  ] 35486 ; Traditional Chinese
  SIMPLEREPORTTEST [ ASCII "ا  ] 1575 ; Arabic
  SIMPLEREPORTTEST [ ASCII "ل  ] 1604 ; Arabic

END

TO RAWASCIITEST.UNICODE

  SIMPLEREPORTTEST [ RAWASCII "ñ   ] 241 ; Latin-1
  SIMPLEREPORTTEST [ RAWASCII "Й   ] 1049 ; Cryillic
  SIMPLEREPORTTEST [ RAWASCII "к   ] 1082 ; Cryillic
  SIMPLEREPORTTEST [ RAWASCII "ε   ] 949 ; Greek
  SIMPLEREPORTTEST [ RAWASCII "η   ] 951 ; Greek
  SIMPLEREPORTTEST [ RAWASCII "汉  ] 27721 ; Simplified Chinese
  SIMPLEREPORTTEST [ RAWASCII "语  ] 35821 ; Simplified Chinese
  SIMPLEREPORTTEST [ RAWASCII "漢  ] 28450 ; Traditional Chinese
  SIMPLEREPORTTEST [ RAWASCII "語  ] 35486 ; Traditional Chinese
  SIMPLEREPORTTEST [ RAWASCII "ا  ] 1575 ; Arabic
  SIMPLEREPORTTEST [ RAWASCII "ل  ] 1604 ; Arabic

END

TO WORDPROCTEST.UNICODE
  SIMPLEREPORTTEST [ (WORD "ñ "Й "к "ε "η "汉 "语 "漢 "語 ) ] "ñЙкεη汉语漢語
END

TO CHARTEST.UNICODE
  ; Test a few different code points from the non-ASCII range of Unicode.
  SIMPLEREPORTTEST [ CHAR 241   ] "ñ  ; Latin-1
  SIMPLEREPORTTEST [ CHAR 1049  ] "Й  ; Cryillic
  SIMPLEREPORTTEST [ CHAR 1082  ] "к  ; Cryillic
  SIMPLEREPORTTEST [ CHAR 949   ] "ε  ; Greek
  SIMPLEREPORTTEST [ CHAR 951   ] "η  ; Greek
  SIMPLEREPORTTEST [ CHAR 27721 ] "汉  ; Simplified Chinese
  SIMPLEREPORTTEST [ CHAR 35821 ] "语  ; Simplified Chinese
  SIMPLEREPORTTEST [ CHAR 28450 ] "漢  ; Traditional Chinese
  SIMPLEREPORTTEST [ CHAR 35486 ] "語  ; Traditional Chinese
  SIMPLEREPORTTEST [ CHAR 1575  ] "ا   ; Arabic
  SIMPLEREPORTTEST [ CHAR 1604  ] "ل   ; Arabic
END


TO WORDUNICODETEST
  WORDPROCTEST.UNICODE
  ASCIITEST.UNICODE
  RAWASCIITEST.UNICODE
  CHARTEST.UNICODE
END
