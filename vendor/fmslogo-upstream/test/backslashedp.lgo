LOAD "testlib.lgo

TO BACKSLASHEDPTEST.SMOKETEST

   ; from the manual
   SIMPLEREPORTTEST [BACKSLASHEDP "a   ] LOCALEFALSE
   SIMPLEREPORTTEST [BACKSLASHEDP "|(| ] LOCALETRUE

   ; from the manual (alternate spelling)
   SIMPLEREPORTTEST [BACKSLASHED? "a   ] LOCALEFALSE
   SIMPLEREPORTTEST [BACKSLASHED? "|(| ] LOCALETRUE

END


TO BACKSLASHEDPTEST.VARIATIONS
   ; test most of the backslashed chars (newline and tab are too hard)
   SIMPLEREPORTTEST [ BACKSLASHEDP "| | ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|+| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|?| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|~| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|[| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|]| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|-| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|*| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|/| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|=| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|<| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|>| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|"| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|:| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|;| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|\||] LOCALETRUE ; vbar
   SIMPLEREPORTTEST [ BACKSLASHEDP "|\\|] LOCALETRUE ; backslash
   SIMPLEREPORTTEST [ BACKSLASHEDP "|{| ] LOCALETRUE
   SIMPLEREPORTTEST [ BACKSLASHEDP "|}| ] LOCALETRUE

   ; vbar-d does not imply backslashed
   SIMPLEREPORTTEST [ BACKSLASHEDP "|a| ] LOCALEFALSE

   ; using a backslash does not make a word backslashed
   SIMPLEREPORTTEST [ BACKSLASHEDP "\  ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\+ ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\? ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\~ ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\[ ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\] ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\- ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\* ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\/ ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\= ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\< ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\> ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\" ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\: ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\; ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\| ] LOCALEFALSE ; vbar
   SIMPLEREPORTTEST [ BACKSLASHEDP "\\ ] LOCALEFALSE ; backslash
   SIMPLEREPORTTEST [ BACKSLASHEDP "\{ ] LOCALEFALSE
   SIMPLEREPORTTEST [ BACKSLASHEDP "\} ] LOCALEFALSE

   ; A backslash copied to a different word
   SIMPLEREPORTTEST [ BACKSLASHEDP ( WORD "|[| ) ] LOCALETRUE

   ; The internal values to which the characters are made
   LOCALMAKE "escapedCodes [
      57344 ; space
      57345 ; tab
      57346 ; newline
      57347 ; open paren
      57348 ; question mark
      57349 ; plus
      57350 ; twiddle
      57351 ; close paren
      57352 ; open bracket
      57353 ; close bracket
      57354 ; minus
      57355 ; asterisk
      57356 ; slash
      57357 ; equals
      57358 ; less than
      57359 ; greater than
      57360 ; double quote
      57361 ; backslash
      57362 ; colon
      57363 ; semicolon
      57364 ; vbar
      57365 ; open brace
      57366 ; close brace
   ]

   ; The entire space of Unicode BMP is too large to search, so we
   ; only test the significant characters.
   REPEAT 256 [
       ; 0 - 255
       FAILIFNOTFALSE (LIST "BACKSLASHEDP "CHAR (REPCOUNT - 1))

       ; 57301 + 57555
       SIMPLEREPORTTEST
           (LIST "BACKSLASHEDP "CHAR 57300 + REPCOUNT)
           MEMBERP (57300 + REPCOUNT) :escapedCodes
   ]

END

TO BACKSLASHEDPTEST.BADINPUT

   ; bad number of inputs
   RUNNOTENOUGHINPUTSTEST [(BACKSLASHEDP)]
   RUNTOOMANYINPUTSTEST   [(BACKSLASHEDP "abc "toomany)]

   ; bad inputs
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP []   ]
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP {a}  ]
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP [a]  ]
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP "aa  ] ; must be single char
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP "|| ]  ; empty string is not a char
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP "12  ] ; numbers are not chars
   RUNDOESNTLIKEINPUTTEST [BACKSLASHEDP "1.2 ]

END

TO BACKSLASHEDPTEST

   BACKSLASHEDPTEST.SMOKETEST
   BACKSLASHEDPTEST.VARIATIONS
   BACKSLASHEDPTEST.BADINPUT

END
