LOAD "testlib.lgo
LOAD "uiautomationlib.lgo

TO STEPTEST.STEPBEFOREDEFINED.PROCEDURE
   ; Make sure that the procedure-to-step does not already exist.
   FAILIFNOTFALSE [MEMBERP "STEPTEST.NEWPROCEDURE PROCEDURES ]

   ; Tests that a procedure can be marked as stepped, even before it's defined.
   TRACEINSTRUCTION [ STEP "STEPTEST.NEWPROCEDURE ]

   ; The stepped procedure doesn't appear as stepped until it exists.
   FAILIFNOTFALSE [MEMBERP "STEPTEST.NEWPROCEDURE (ITEM 1 STEPPED) ]
   FAILIFNOTFALSE [MEMBERP "STEPTEST.NEWPROCEDURE PROCEDURES ]

   ; DEFINE the stepped procedure.
   TRACEINSTRUCTION [ DEFINE "STEPTEST.NEWPROCEDURE [[]] ]

   ; The stepped procedure should now appear as stepped.
   FAILIFNOTTRUE [MEMBERP "STEPTEST.NEWPROCEDURE (ITEM 1 STEPPED) ]
   FAILIFNOTTRUE [MEMBERP "STEPTEST.NEWPROCEDURE PROCEDURES ]

   ; ERASE the stepped procedure.
   TRACEINSTRUCTION [ ERASE "STEPTEST.NEWPROCEDURE ]

   ; The stepped procedure should no longer appear as stepped.
   FAILIFNOTFALSE [MEMBERP "STEPTEST.NEWPROCEDURE (ITEM 1 STEPPED) ]
   FAILIFNOTFALSE [MEMBERP "STEPTEST.NEWPROCEDURE PROCEDURES ]

   ; DEFINE the procedure (again)
   TRACEINSTRUCTION [ DEFINE "STEPTEST.NEWPROCEDURE [[]] ]

   ; The stepped procedure should still appear as stepped.
   FAILIFNOTTRUE [MEMBERP "STEPTEST.NEWPROCEDURE (ITEM 1 STEPPED) ]
   FAILIFNOTTRUE [MEMBERP "STEPTEST.NEWPROCEDURE PROCEDURES ]

   ; Cleanup
   TRACEINSTRUCTION [ ERASE  "STEPTEST.NEWPROCEDURE ]
   TRACEINSTRUCTION [ UNSTEP "STEPTEST.NEWPROCEDURE ]
END

TO STEPTEST.STEPBEFOREDEFINED.VARIABLE
   ; Make sure that the variable-to-step does not already exist.
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; Tests that a variable can be marked as stepped, even before it's defined.
   TRACEINSTRUCTION [ STEP [[] [steptest.newvariable] ] ]

   ; The stepped variable doesn't appear as stepped until it exists.
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 STEPPED)  ]
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; MAKE the stepped variable.
   TRACEINSTRUCTION [ MAKE "steptest.newvariable 123 ]

   ; The stepped variable should now appear as stepped.
   FAILIFNOTTRUE [MEMBERP "steptest.newvariable (ITEM 2 STEPPED)  ]
   FAILIFNOTTRUE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; ERASE the stepped variable.
   TRACEINSTRUCTION [ ERASE [[] [steptest.newvariable] ] ]

   ; The stepped variable should no longer appear as stepped.
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 STEPPED)  ]
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; Create a LOCAL scope for the varible.
   LOCAL "steptest.newvariable

   ; A variable with a scope but no definition does not appear as stepped.
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 STEPPED) ]
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; Assign a value to the variable.
   TRACEINSTRUCTION [ MAKE "steptest.newvariable [] ]

   ; The variable should now appear as stepped, now that it has a value.
   FAILIFNOTTRUE [MEMBERP "steptest.newvariable (ITEM 2 STEPPED) ]
   FAILIFNOTTRUE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; Cleanup
   TRACEINSTRUCTION [ UNSTEP [[] [steptest.newvarible] ] ]
END

TO STEPTEST.STEPBEFOREDEFINED.PLIST
   ; Make sure that the property list to step does not already exist.
   FAILIFNOTFALSE [MEMBERP "steptest.newpropertylist (ITEM 3 PLISTS) ]

   ; Test that a property list can be marked as stepped, even before it's created.
   TRACEINSTRUCTION [ STEP [[] [] [steptest.newpropertylist]] ]

   ; The stepped property list doesn't appear as stepped until it exists.
   FAILIFNOTFALSE [MEMBERP "steptest.newpropertylist (ITEM 3 STEPPED) ]
   FAILIFNOTFALSE [MEMBERP "steptest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Create the stepped property list
   TRACEINSTRUCTION [ PPROP "steptest.newpropertylist "property [] ]

   ; The stepped property list should now appear as stepped.
   FAILIFNOTTRUE [MEMBERP "steptest.newpropertylist (ITEM 3 STEPPED)  ]
   FAILIFNOTTRUE [MEMBERP "steptest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Remove the property from the stepped property list.
   TRACEINSTRUCTION [ REMPROP "steptest.newpropertylist "property ]

   ; The stepped property list should no longer appear as stepped.
   FAILIFNOTFALSE [MEMBERP "steptest.newpropertylist (ITEM 3 STEPPED)  ]
   FAILIFNOTFALSE [MEMBERP "steptest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Recreate the property list
   TRACEINSTRUCTION [ PPROP "steptest.newpropertylist "property 0 ]

   ; The stepped property list should once again appear as stepped.
   FAILIFNOTTRUE [MEMBERP "steptest.newpropertylist (ITEM 3 STEPPED)  ]
   FAILIFNOTTRUE [MEMBERP "steptest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Cleanup
   TRACEINSTRUCTION [ REMPROP "steptest.newpropertylist "property ]
   TRACEINSTRUCTION [ UNSTEP [[] [] [steptest.newpropertylist]]   ]
END


TO STEPTEST.STEPPEDPROCEDURE
   SHOW [This is line one of STEPTEST.STEPPEDPROCEDURE]
   SHOW [This is line two of STEPTEST.STEPPEDPROCEDURE]
END

; Shadow STEPTEST.STEPPEDVARIABLE with LOCAL
TO STEPTEST.SHADOWVARIABLEWITHLOCAL
   LOCAL [STEPTEST.STEPPEDVARIABLE]
   MAKE "STEPTEST.STEPPEDVARIABLE 123
END

; Shadow STEPTEST.STEPPEDVARIABLE with a parameter name
TO STEPTEST.SHADOWVARIABLE [:STEPTEST.STEPPEDVARIABLE 1]
END


TO STEPTEST.PROCEDURE
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   UIAUTOMATION.INITIALIZE

   CATCH "ERROR [
     ; make sure the procedure is not already traced
     FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDPROCEDURE (ITEM 1 STEPPED) ]

     ; step the procedure
     TRACEINSTRUCTION [STEP "STEPTEST.STEPPEDPROCEDURE]

     ; make sure the procedure is stepped
     FAILIFNOTTRUE [MEMBERP "STEPTEST.STEPPEDPROCEDURE (ITEM 1 STEPPED) ]

     ; call it (it should be single stepped step)
     UIAUTOMATION.POSTBUTTONPUSHTOWINDOW "|Single Step| "Ok
     UIAUTOMATION.POSTBUTTONPUSHTOWINDOW "|Single Step| "Ok
     TRACEINSTRUCTION [STEPTEST.STEPPEDPROCEDURE]

     ; unstep the procedure
     TRACEINSTRUCTION [UNSTEP "STEPTEST.STEPPEDPROCEDURE]

     ; make sure the procedure is not stepped anymore
     FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDPROCEDURE (ITEM 1 STEPPED) ]

     ; call it (it should no longer trace the output)
     TRACEINSTRUCTION [STEPTEST.STEPPEDPROCEDURE]
   ]

   IGNORE FAILIFERROR "STEPTEST.PROCEDURE

   UIAUTOMATION.UNINITIALIZE

END


TO STEPTEST.VARIABLE

   LOCALMAKE "STEPTEST.STEPPEDVARIABLE 0

   ; make sure the variable is not already stepped
   FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDVARIABLE (ITEM 2 STEPPED) ]

   ; step the variable
   TRACEINSTRUCTION [STEP NAMELIST "STEPTEST.STEPPEDVARIABLE]

   ; make sure the variable is stepped
   FAILIFNOTTRUE [MEMBERP "STEPTEST.STEPPEDVARIABLE (ITEM 2 STEPPED) ]

   ; shadow the variable (this should trace to the commander box)
   TRACEINSTRUCTION [STEPTEST.SHADOWVARIABLE]

   ; shadow the variable (this should trace to the commander box)
   TRACEINSTRUCTION [ STEPTEST.SHADOWVARIABLEWITHLOCAL ]

   ; unstep the variable
   TRACEINSTRUCTION [UNSTEP NAMELIST "STEPTEST.STEPPEDVARIABLE]

   ; make sure the variable is not stepped anymore
   FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDVARIABLE (ITEM 2 STEPPED) ]

   ; shadowing the variable should have no effect now
   TRACEINSTRUCTION [STEPTEST.SHADOWVARIABLE]

END

TO STEPTEST.PROPERTYLIST

   ; create the propery list
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "SOMEPROPERTY 0 ]

   ; make sure the propery list is not already stepped
   FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDPLIST (ITEM 3 STEPPED) ]

   ; step the propery list
   TRACEINSTRUCTION [STEP PLLIST "STEPTEST.STEPPEDPLIST]

   ; make sure the propery list is stepped
   FAILIFNOTTRUE [MEMBERP "STEPTEST.STEPPEDPLIST (ITEM 3 STEPPED) ]

   ; put some properties in the propery list
   ; this shouldn't do anything (stepping a property list has no effect)
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "PROPERTY1 123     ]
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "PROPERTY2 "123    ]
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "PROPERTY3 "value  ]
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "PROPERTY4 [1 2 3] ]
   TRACEINSTRUCTION [PPROP "STEPTEST.STEPPEDPLIST "PROPERTY5 {1 2 3} ]

   ; unstep the propery list
   TRACEINSTRUCTION [UNSTEP PLLIST "STEPTEST.STEPPEDPLIST]

   ; make sure the propery list is not traced anymore
   FAILIFNOTFALSE [MEMBERP "STEPTEST.STEPPEDPLIST (ITEM 3 STEPPED) ]

   ; cleanup
   ERASE PLLIST "STEPTEST.STEPPEDPLIST

END

TO STEPTEST.STEPALL
  IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   UIAUTOMATION.INITIALIZE

   ; To make running this test easier, this test tries not to do too
   ; much while every procedure is stepped.
   UIAUTOMATION.POSTBUTTONPUSHTOWINDOW "|Single Step| "Ok
   UIAUTOMATION.POSTBUTTONPUSHTOWINDOW "|Single Step| "Ok

   ; step everything
   REPORTTESTINFO [Running STEP CONTENTS]
   STEP CONTENTS

   IF NOT EQUAL? STEPPED CONTENTS [
      REPORTTESTFAILED [STEPPED did not output the entire contents list.]
   ]

   ; step nothing
   UNSTEP CONTENTS
   REPORTTESTINFO [Ran UNSTEP CONTENTS]

   SIMPLEREPORTTEST [STEPPED] [[][][]]

   UIAUTOMATION.UNINITIALIZE
END

TO STEPTEST.BADINPUT

   RUNTOOMANYINPUTSTEST [(STEPPED "toomany)]

   TRACEINSTRUCTION       [(STEP [[nonexistent] [nonexistent] [nonexistent]])]
   RUNNOTENOUGHINPUTSTEST [(STEP)]
   RUNTOOMANYINPUTSTEST   [(STEP "name "toomany)]
   RUNBADINPUTTEST        [(STEP {name})]
   RUNBADINPUTTEST        [(STEP [[a][b]{c}])]
   RUNBADINPUTTEST        [(STEP [a b {c}])]
   RUNBADINPUTTEST        [(STEP [[a b {c}]])]
   RUNBADINPUTTEST        [(STEP [[a][b][c][d]])]
   RUNBADINPUTTEST        [(STEP [[[a]]])]

   TRACEINSTRUCTION       [(UNSTEP [[nonexistent] [nonexistent] [nonexistent]])]
   RUNNOTENOUGHINPUTSTEST [(UNSTEP)]
   RUNTOOMANYINPUTSTEST   [(UNSTEP "name "toomany)]
   RUNBADINPUTTEST        [(UNSTEP {name})]
   RUNBADINPUTTEST        [(UNSTEP [[][]{}])]
   RUNBADINPUTTEST        [(UNSTEP [word word {array}])]
   RUNBADINPUTTEST        [(UNSTEP [[][][][]])]
   RUNBADINPUTTEST        [(UNSTEP [[a][b]{c}])]
   RUNBADINPUTTEST        [(UNSTEP [a b {c}])]
   RUNBADINPUTTEST        [(UNSTEP [[a b {c}]])]
   RUNBADINPUTTEST        [(UNSTEP [[a][b][c][d]])]
   RUNBADINPUTTEST        [(UNSTEP [[[a]]])]
END

TO STEPTEST.WITHTIMEREVENT.CALLBACK
  IGNORE [This instruction should only appear once in a single "Single Step" dialog]
END

TO STEPTEST.WITHTIMEREVENT
   ; This is a regression test for bug #573.
   ; The bug was that, if you press the "Step" button on the commander
   ; and you have a timer event running, the "Single Step" dialog box will
   ; appear each time the timer event is run, potentially flooding the screen
   ; with dialog boxes.  Worse, because each new timer event is run from
   ; the context of the previous dialog box, it could cause a stack overflow,
   ; crashing FMSLogo.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Start a timer event running every 100 ms.
   TRACEINSTRUCTION [ SETTIMER 14 100 [ STEPTEST.WITHTIMEREVENT.CALLBACK ] ]

   UIAUTOMATION.INITIALIZE

   CATCH "ERROR [
     ; Queue some events on the UIAUTOMATION queue before entering "step" mode:
     ; #1: Unstep the timer event callback.  This is like pressing "Unstep".
     ; #2: Press "Ok" on the "Single Step" dialog box to dismiss it.
     UIAUTOMATION.POSTEVENT [ [ UNSTEP "STEPTEST.WITHTIMEREVENT.CALLBACK ] [] ]
     UIAUTOMATION.POSTBUTTONPUSHTOWINDOW "|Single Step| "Ok

     ; Now, STEP the timer event callback.  This is like pressing the Step button
     ; but it avoids single-stepping the UIAUTOMATION code, which would
     ; interfere with the test.
     TRACEINSTRUCTION [ STEP "STEPTEST.WITHTIMEREVENT.CALLBACK ]

     ; Wait two seconds.  This should be long enough for the timer
     ; event callback to run many times while it is single-stepped.
     ; The first time it's called, it should display the "Single Step"
     ; dialog box, which will be dismissed by the UIAUTOMATION events
     ; posted above.
     WAIT 60
   ]

   IGNORE FAILIFERROR "STEPTEST.WITHTIMEREVENT

   ; Cleanup
   UIAUTOMATION.UNINITIALIZE
   TRACEINSTRUCTION [ CLEARTIMER 14 ]
END

TO STEPTEST

   STEPTEST.PROCEDURE
   STEPTEST.VARIABLE
   STEPTEST.PROPERTYLIST
   STEPTEST.STEPALL
   STEPTEST.BADINPUT
   STEPTEST.WITHTIMEREVENT

   STEPTEST.STEPBEFOREDEFINED.PROCEDURE
   STEPTEST.STEPBEFOREDEFINED.VARIABLE
   STEPTEST.STEPBEFOREDEFINED.PLIST

END
