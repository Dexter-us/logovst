LOAD "testlib.lgo
LOAD "dllcall/setclipboarddata.lgo

TO FILETEST.SETACCESS :mode :filename
   ; Changes the permission on a file.
   ; Since there's no way to do this within FMSLogo, it's done with chmod.
   ;
   ; :mode
   ;   A word that contains "r" to enable read and "w" to enable write.
   ; :filename
   ;   The name of the file whose permissions to be changed.
   ;
   LOCAL [shellcommand chmodmode]

   ; Convert "rw" style mode into chmod-style mode.
   IFELSE MEMBERP "r :mode [
      IFELSE MEMBERP "w :mode [
         MAKE "chmodmode "0600 ; read+write
      ][
         MAKE "chmodmode "0400 ; read only
      ]
   ][
      IFELSE MEMBERP "w :mode [
         MAKE "chmodmode "0200 ; write only
      ][
         MAKE "chmodmode "0000 ; no access
      ]
   ]

   ; Execute something like:
   ;   chmod 0400 myfile.txt
   MAKE "shellcommand (LIST "chmod :chmodmode :filename)
   FAILIFNOTTRUE (LIST "\( "SHELL QUOTED :shellcommand  QUOTED LOCALETRUE "\) )
END

TO FILETEST.SMOKETEST.HELPER :writefilename :readfilename

   ; erase the file, just in case
   ERASEFILE :writefilename
   ERASEFILE :readfilename

   ;
   ; Write some simple data to a test file
   ;
   OPENWRITE :writefilename
   FAILIFNOTTRUE [ MEMBERP :writefilename ALLOPEN ]
   SETWRITE  :writefilename
   SIMPLEREPORTTEST [WRITER] :writefilename
   SIMPLEREPORTTEST [WRITEPOS] 0
   PRINT "Hello
   SIMPLEREPORTTEST [WRITEPOS] 10 ; BOM (3) + Hello (5) + CRLF (2)
   PRINT [Good Bye]
   SIMPLEREPORTTEST [WRITEPOS] 20 ; + Good Bye (8) + CRLF (2)

   SETWRITE []
   SIMPLEREPORTTEST [WRITER] []
   CLOSE :writefilename

   ;
   ; Now, read the file using the alternate name
   ;
   OPENREAD :readfilename
   SETREAD  :readfilename
   SIMPLEREPORTTEST [READER] :readfilename

   SIMPLEREPORTTEST [READPOS] 0
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READPOS] 10
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [Good Bye]
   SIMPLEREPORTTEST [READPOS] 20
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE :readfilename

   ; Cleanup
   ERASEFILE :readfilename
   ERASEFILE :writefilename
END

TO FILETEST.SMOKETEST
   FILETEST.SMOKETEST.HELPER "smoketest.txt "smoketest.txt
END

TO FILETEST.NUMBERFILENAME
   FILETEST.SMOKETEST.HELPER 123 "123
END

TO FILETEST.UNICODEFILENAME
   LOCAL [greekSigma filename]
   MAKE "greekSigma CHAR 963
   MAKE "filename   (WORD "filetest.unicode :greekSigma ".txt)

   FILETEST.SMOKETEST.HELPER :filename :filename
END

TO FILETEST.SPACESINFILENAME
   ; Attempts to read/write a file that has spaces in its name.
   ; This is a regression test for Bug #578.
   FILETEST.SMOKETEST.HELPER "filetest-two\ \ spaces.txt "|filetest-two  spaces.txt|
END

TO FILETEST.CASEINSENSTIVEFILENAME
   ; Attempts to read/write a file that has spaces in its name.
   ; This is a regression test for Bug #578.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows 
   FILETEST.SMOKETEST.HELPER "filetest.txt "FILETEST.TXT
END



TO FILETEST.OPENREAD.ANSI
   ; Tests that text file with a BOM are read with the ANSI text,
   ; as they were prior to FMSLogo 8.0.
   LOCALMAKE "cr  CHAR 13
   LOCALMAKE "lf  CHAR 10

   WRITEBINARYDATA "filetest.openread.ascii.txt (WORD
     "A :cr :lf      ; CRLF
     "B :cr :cr :lf  ; CRCRLF
     "C :cr :lf :lf  ; CRLFLF
     CHAR 180        ; not ASCII
     CHAR 190        ; not ASCII
   )

   ;
   ; Now, read the file in the default mode.
   ;
   OPENREAD "filetest.openread.ascii.txt
   SETREAD  "filetest.openread.ascii.txt
   FILETEST.READERSTATETEST  0 LOCALEFALSE "A
   FILETEST.READERSTATETEST  1 LOCALEFALSE :lf
   FILETEST.READERSTATETEST  3 LOCALEFALSE "B
   FILETEST.READERSTATETEST  4 LOCALEFALSE :cr
   FILETEST.READERSTATETEST  5 LOCALEFALSE :lf
   FILETEST.READERSTATETEST  7 LOCALEFALSE "C
   FILETEST.READERSTATETEST  8 LOCALEFALSE :lf
   FILETEST.READERSTATETEST 10 LOCALEFALSE :lf
   FILETEST.READERSTATETEST 11 LOCALEFALSE CHAR 180 ; (varies by locale)
   FILETEST.READERSTATETEST 12 LOCALEFALSE CHAR 190 ; (varies by locale)
   FILETEST.READERSTATETEST 13  LOCALETRUE []
   SETREAD []
   CLOSE "filetest.openread.ascii.txt

   ERASEFILE "filetest.openread.ascii.txt
END

TO FILETEST.OPENREAD.UTF8
   ; Tests that text file encoded in UTF-8 can be read using OPENREAD.

   LOCALMAKE "bom            CHAR 65279
   LOCALMAKE "greekSigma     CHAR 963
   LOCALMAKE "utf8Bom        (WORD CHAR 239 CHAR 187 CHAR 191)
   LOCALMAKE "utf8GreekSigma (WORD CHAR 207 CHAR 131)
   LOCALMAKE "crlf           (WORD CHAR 13 CHAR 10)

   ;
   ; Write the contents of UTF-8 encoded text file.
   ; This uses characters with 1-, 2-, and 3-byte codings.
   ;
   WRITEBINARYDATA "filetest.unicode.txt (WORD
     :utf8Bom
     "Hello :utf8GreekSigma :utf8GreekSigma :crlf  ; 1- and 2-character codings
     "|Good | :utf8Bom "| Bye| :crlf               ; 3-character coding
   )

   ;
   ; Now, read the file in the default mode.
   ;
   OPENREAD "filetest.unicode.txt
   SETREAD  "filetest.unicode.txt
   SIMPLEREPORTTEST [READER] "filetest.unicode.txt

   SIMPLEREPORTTEST [READPOS] 0 ; at the beginning
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] (LIST (WORD "Hello :greekSigma :greekSigma))
   SIMPLEREPORTTEST [READPOS] 14 ; BOM(3) + Hello(5) + sigma(2) + sigma(2) + EOL(2)
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] (LIST "Good :bom "Bye)
   SIMPLEREPORTTEST [READPOS] 28 ; 14 + "Good BOM Bye"(12) + EOL(2)
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "filetest.unicode.txt

   ERASEFILE "filetest.unicode.txt
END

TO FILETEST.OPENREAD.UTF8.VARIATIONS
   ; Tests that character variations on reading UTF-8 encoded sequences.
   ; This includes malformed sequences.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   LOCALMAKE "utf8Bom      (WORD CHAR 239 CHAR 187 CHAR 191)
   LOCALMAKE "utf8Char1Min (WORD CHAR 0)
   LOCALMAKE "utf8Char1Max (WORD CHAR 127)

   LOCALMAKE "utf8Char2Nul (WORD CHAR 192 CHAR 128)
   LOCALMAKE "utf8Char2Min (WORD CHAR 194 CHAR 128)
   LOCALMAKE "utf8Char2Max (WORD CHAR 223 CHAR 191)

   LOCALMAKE "utf8Char3Nul (WORD CHAR 224 CHAR 128 CHAR 128)
   LOCALMAKE "utf8Char3Min (WORD CHAR 224 CHAR 160 CHAR 128)
   LOCALMAKE "utf8Char3Max (WORD CHAR 239 CHAR 191 CHAR 191)

   LOCALMAKE "utf8Char4Nul (WORD CHAR 240 CHAR 128 CHAR 128 CHAR 128)
   LOCALMAKE "utf8Char4Min (WORD CHAR 247 CHAR 144 CHAR 128 CHAR 128)
   LOCALMAKE "utf8Char4Max (WORD CHAR 247 CHAR 191 CHAR 191 CHAR 191)

   ; UTF-8 only specifies up to 4-byte codings, but you can follow the
   ; pattern to create illegal 5- and 6- byte codings.
   LOCALMAKE "utf8Char5Max (WORD CHAR 251 CHAR 191 CHAR 191 CHAR 191 CHAR 191)
   LOCALMAKE "utf8Char6Max (WORD CHAR 253 CHAR 191 CHAR 191 CHAR 191 CHAR 191 CHAR 191)

   LOCALMAKE "utf8NonStartByte CHAR 187

   WRITEBINARYDATA "filetest.unicode.txt (WORD
     :utf8Bom
     :utf8Char1Min ; min char in 1-char coding
     :utf8Char1Max ; max char in 1-char coding
     :utf8Char2Min ; min char in 2-char coding
     :utf8Char2Max ; max char in 2-char coding
     :utf8Char3Min ; min char in 3-char coding
     :utf8Char3Max ; max char in 3-char coding
     :utf8Char4Min ; min char in 4-char coding
     :utf8Char4Max ; max char in 4-char coding

     :utf8NonStartByte :utf8NonStartByte ; illegal sequence

     :utf8Char2Min ; legal again

     :utf8Char2Nul ; overlong NUL (2-bytes)
     :utf8Char3Nul ; overlong NUL (3-bytes)
     :utf8Char4Nul ; overlong NUL (4-bytes)

     :utf8Char5Max ; illegal 5-byte sequence
     :utf8Char6Max ; illegal 6-byte sequence
     CHAR 254      ; 0xFE is also illegal
     CHAR 255      ; 0xFF is also illegal
     :utf8Char1Min ; legal 1-byte sequence

     CHAR 224 ; end the file on the start of a three-byte sequence
   )

   ;
   ; Now, read the file
   ;
   LOCALMAKE "char1Min CHAR 0
   LOCALMAKE "char1Max CHAR 127
   LOCALMAKE "char2Min CHAR 128
   LOCALMAKE "char2Max CHAR 2047
   LOCALMAKE "char3Min CHAR 2048
   LOCALMAKE "char3Max CHAR 65535
   LOCALMAKE "char4Min CHAR 65536
   LOCALMAKE "char4Max CHAR 1114111 ; silent bug, this wraps at 0x10000.

   OPENREAD "filetest.unicode.txt
   SETREAD  "filetest.unicode.txt
   FILETEST.READERSTATETEST  0 LOCALEFALSE :char1Min
   FILETEST.READERSTATETEST  4 LOCALEFALSE :char1Max
   FILETEST.READERSTATETEST  5 LOCALEFALSE :char2Min
   FILETEST.READERSTATETEST  7 LOCALEFALSE :char2Max
   FILETEST.READERSTATETEST  9 LOCALEFALSE :char3Min
   FILETEST.READERSTATETEST 12 LOCALEFALSE :char3Max
   FILETEST.READERSTATETEST 15 LOCALEFALSE :char4Min
   FILETEST.READERSTATETEST 19 LOCALEFALSE :char4Max
   FILETEST.READERSTATETEST 23 LOCALEFALSE :char2Min ; illegal sequences are skipped
   FILETEST.READERSTATETEST 27 LOCALEFALSE :char1Min ; overlong UTF-8 is accepted
   FILETEST.READERSTATETEST 29 LOCALEFALSE :char1Min ; overlong UTF-8 is accepted
   FILETEST.READERSTATETEST 32 LOCALEFALSE :char1Min ; overlong UTF-8 is accepted
   FILETEST.READERSTATETEST 36 LOCALEFALSE :char1Min ; illegal sequences are skipped

   FILETEST.READERSTATETEST 50 LOCALEFALSE []        ; truncated sequence at EOF is not returned
   FILETEST.READERSTATETEST 51 LOCALETRUE  []        ; now at EOF
   SETREAD []
   CLOSE "filetest.unicode.txt

   ERASEFILE "filetest.unicode.txt
END

TO FILETEST.OPENREAD.UTF8.EOLVARIATIONS
   ; Tests variations on the EOL sequence in a UTF-8 encoded file.
   LOCALMAKE "cr  CHAR 13
   LOCALMAKE "lf  CHAR 10

   WRITEBINARYDATA "filetest.unicode.txt (WORD
     CHAR 239 CHAR 187 CHAR 191 ; UTF-8 BOM
     "A :cr :lf                 ; real EOL
     "B :cr :cr :lf             ; real CRLF after CR
     "C :cr :lf :lf             ; real LF after CRLF
     "D :cr :cr                 ; real CRCR with no LF (EOF)
   )

   OPENREAD "filetest.unicode.txt
   SETREAD  "filetest.unicode.txt
   FILETEST.READERSTATETEST  0 LOCALEFALSE "A
   FILETEST.READERSTATETEST  4 LOCALEFALSE :lf ; CRLF -> LF
   FILETEST.READERSTATETEST  6 LOCALEFALSE "B
   FILETEST.READERSTATETEST  7 LOCALEFALSE :cr ; CR in CRCRLF
   FILETEST.READERSTATETEST  8 LOCALEFALSE :lf ; CRLF
   FILETEST.READERSTATETEST 10 LOCALEFALSE "C
   FILETEST.READERSTATETEST 11 LOCALEFALSE :lf ; CRLF in CRLFLF
   FILETEST.READERSTATETEST 13 LOCALEFALSE :lf ; LF at end
   FILETEST.READERSTATETEST 14 LOCALEFALSE "D
   FILETEST.READERSTATETEST 15 LOCALEFALSE :cr
   FILETEST.READERSTATETEST 16 LOCALEFALSE :cr ; CR at EOF
   FILETEST.READERSTATETEST 17  LOCALETRUE []
   SETREAD []
   CLOSE "filetest.unicode.txt

   ERASEFILE "filetest.unicode.txt
END


TO FILETEST.OPENREAD.UTF16LE
   ; Tests a text file encoded in UTF-16LE can be read using OPENREAD.

   ; Define some variables that hold UTF-16LE codings
   LOCALMAKE "greekSigma  WORD CHAR 195 CHAR   3
   LOCALMAKE "bom         WORD CHAR 255 CHAR 254
   LOCALMAKE "B           WORD CHAR  66 CHAR   0
   LOCALMAKE "G           WORD CHAR  71 CHAR   0
   LOCALMAKE "H           WORD CHAR  72 CHAR   0
   LOCALMAKE "d           WORD CHAR 100 CHAR   0
   LOCALMAKE "e           WORD CHAR 101 CHAR   0
   LOCALMAKE "l           WORD CHAR 108 CHAR   0
   LOCALMAKE "o           WORD CHAR 111 CHAR   0
   LOCALMAKE "y           WORD CHAR 121 CHAR   0
   LOCALMAKE "space       WORD CHAR  32 CHAR   0
   LOCALMAKE "cr          WORD CHAR  13 CHAR   0
   LOCALMAKE "lf          WORD CHAR  10 CHAR   0

   ; The character in native Unicode
   LOCALMAKE "nativeGreekSigma CHAR 963

   ;
   ; Create a test file that is encoded in UTF-16LE.
   ;
   WRITEBINARYDATA "filetest.unicode.txt (WORD
      :bom
      :H :e :l :l :o :greekSigma :greekSigma :cr :lf
      :G :o :o :d :space :greekSigma :space :B :y :e :cr :lf
   )

   ;
   ; Now, read the file in the default mode.
   ;
   OPENREAD "filetest.unicode.txt
   SETREAD  "filetest.unicode.txt
   SIMPLEREPORTTEST [READER] "filetest.unicode.txt

   SIMPLEREPORTTEST [READPOS] 0 ; at the beginning
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] (LIST (WORD "Hello :nativeGreekSigma :nativeGreekSigma))
   SIMPLEREPORTTEST [READPOS] 20 ; BOM(2) + Hello(10) + sigma(2) + sigma(2) + EOL(4)
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] (LIST "Good :nativeGreekSigma "Bye)
   SIMPLEREPORTTEST [READPOS] 44 ; 20 + "Good SIGMA Bye"(20) + EOL(4)

   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "filetest.unicode.txt

   ERASEFILE "filetest.unicode.txt

END

TO FILETEST.READERSTATETEST :expectedPosition :expectedEof :expectedCharacter 
   SIMPLEREPORTTEST [READPOS]  :expectedPosition
   SIMPLEREPORTTEST [EOFP]     :expectedEof
   SIMPLEREPORTTEST [READCHAR] :expectedCharacter
END

TO FILETEST.OPENREAD.UTF16LE.EOLVARIATIONS
   ; Tests variations on reading not-quite EOL sequences from
   ; a file encoded in UTF-16LE.
   LOCALMAKE "filename "filetest.openread.utf16le.eolvariations.txt

   LOCALMAKE "NUL CHAR 0
   LOCALMAKE "SOH CHAR 1
   LOCALMAKE "TAB CHAR 9
   LOCALMAKE "LF  CHAR 10
   LOCALMAKE "CR  CHAR 13
   LOCALMAKE "A   CHAR 65
   LOCALMAKE "B   CHAR 66
   LOCALMAKE "C   CHAR 67
   LOCALMAKE "D   CHAR 68
   LOCALMAKE "E   CHAR 69
   LOCALMAKE "F   CHAR 70
   LOCALMAKE "G   CHAR 71
   LOCALMAKE "H   CHAR 72

   ;
   ; Write some data to a test file.
   ;
   WRITEBINARYDATA :filename (WORD
      CHAR 255 CHAR 254                      ; UTF-16 BOM
      :A :NUL  :CR :NUL  :LF  :NUL           ; real EOL
      :B :NUL  :CR :NUL  :LF  :SOH           ; not a LF (bad low byte)
      :C :NUL  :CR :NUL  :TAB :NUL           ; not a LF (bad high byte)
      :D :NUL :TAB :NUL  :LF  :NUL           ; not a real CR (bad low byte)
      :E :NUL  :CR :SOH  :CR  :NUL  :LF :NUL ; real CRLF after bad CR (bad low byte)
      :F :NUL  :CR :NUL  :CR  :NUL  :LF :NUL ; CRCRLF
      :G :NUL  :CR :LF                       ; CRLF in UTF-8, but 0x0A0D in UTF-16
      :H :NUL  :CR :NUL  :LF                 ; EOF before CRLF finishes
   )

   ;
   ; Now, read the file in the default mode.
   ;
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST  0 LOCALEFALSE :A
   FILETEST.READERSTATETEST  4 LOCALEFALSE :LF

   FILETEST.READERSTATETEST  8 LOCALEFALSE :B
   FILETEST.READERSTATETEST 10 LOCALEFALSE :CR
   FILETEST.READERSTATETEST 12 LOCALEFALSE CHAR SUM 256 10 ; :LF :SOH

   FILETEST.READERSTATETEST 14 LOCALEFALSE :C
   FILETEST.READERSTATETEST 16 LOCALEFALSE :CR
   FILETEST.READERSTATETEST 18 LOCALEFALSE :TAB

   FILETEST.READERSTATETEST 20 LOCALEFALSE :D
   FILETEST.READERSTATETEST 22 LOCALEFALSE :TAB
   FILETEST.READERSTATETEST 24 LOCALEFALSE :LF

   FILETEST.READERSTATETEST 26 LOCALEFALSE :E
   FILETEST.READERSTATETEST 28 LOCALEFALSE CHAR SUM 256 13 ; :CR :SOH
   FILETEST.READERSTATETEST 30 LOCALEFALSE :LF             ; CRLF -> LF

   FILETEST.READERSTATETEST 34 LOCALEFALSE :F
   FILETEST.READERSTATETEST 36 LOCALEFALSE :CR
   FILETEST.READERSTATETEST 38 LOCALEFALSE :LF             ; CRLF -> LF

   FILETEST.READERSTATETEST 42 LOCALEFALSE :G
   FILETEST.READERSTATETEST 44 LOCALEFALSE CHAR (10*256 + 13) ; :CR :LF

   FILETEST.READERSTATETEST 46 LOCALEFALSE :H
   FILETEST.READERSTATETEST 48 LOCALEFALSE :CR ; the truncated CRLF is just a CR
   FILETEST.READERSTATETEST 50 LOCALEFALSE []  ; EOF (the half char is never output)
   FILETEST.READERSTATETEST 51 LOCALETRUE  []  ; EOF (the half char is never output)
   FILETEST.READERSTATETEST 51 LOCALETRUE  []  ; EOF (the half char is never output)

   SETREAD []
   CLOSE   :filename

   ERASEFILE :filename
END

TO FILETEST.OPENREAD.BOMSNIFFING
   ; Tests variations on reading a BOM from a file.
   LOCALMAKE "filename "filetest.openread.bomsniffing.txt

   ; Test: one-byte file with start of UTF-16 BOM
   ; This should be interpreted as a one-character ANSI file containing
   ; the character that's at code point 255 on the system code page
   ; (varies depending on locale)
   WRITEBINARYDATA :filename CHAR 255
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 255
   FILETEST.READERSTATETEST 1 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: one-byte file with part of a UTF-16 BOM, followed by
   ; byte that's doesn't complete the BOM.
   ; This should be interpreted as a one-character ANSI file containing
   ; the character that's at code point 239 on the system code page
   ; (varies depending on locale)
   WRITEBINARYDATA :filename WORD CHAR 255 CHAR 255
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 255
   FILETEST.READERSTATETEST 1 LOCALEFALSE CHAR 255
   FILETEST.READERSTATETEST 2 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: UTF-16 BOM with nothing after it.
   ; This should be interpreted as an empty file.
   WRITEBINARYDATA :filename WORD CHAR 255 CHAR 254
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALETRUE  []
   SETREAD []
   CLOSE :filename


   ; Test: a one-byte file with the start of UTF-8 BOM
   ; This should be interpreted as a one-character ANSI file containing
   ; the character that's at code point 239 on the system code page
   ; (varies depending on locale)
   WRITEBINARYDATA :filename CHAR 239
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 239
   FILETEST.READERSTATETEST 1 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: a two-byte file with the start of UTF-8 BOM.
   ; This should be interpreted as a two-character ANSI file containing
   ; the character that's at code point 239, followed by the one
   ; at code point 187 (both from the system code page).
   ; (varies depending on locale)
   WRITEBINARYDATA :filename WORD CHAR 239 CHAR 187
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 239
   FILETEST.READERSTATETEST 1 LOCALEFALSE CHAR 187
   FILETEST.READERSTATETEST 2 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: a two-byte file with the start of UTF-8 BOM, but followed
   ; by a second byte that isn't part of the BOM.
   ; This should be interpreted as a two-character ANSI file containing
   ; the character that's at code point 239, followed by the one
   ; at code point 186 (both from the system code page).
   ; (varies depending on locale)
   WRITEBINARYDATA :filename WORD CHAR 239 CHAR 186
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 239
   FILETEST.READERSTATETEST 1 LOCALEFALSE CHAR 186
   FILETEST.READERSTATETEST 2 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: a two-byte file with the start of UTF-8 BOM, but whose
   ; third byte is not part of the BOM.
   ; This should be interpreted as a three-character ANSI file
   ; containing the character that's at code point 239, followed by
   ; the one at code point 186, followed by the one at code point
   ; 192 (all from the system code page).
   ; (varies depending on locale)
   WRITEBINARYDATA :filename (WORD CHAR 239 CHAR 186 CHAR 192)
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALEFALSE CHAR 239
   FILETEST.READERSTATETEST 1 LOCALEFALSE CHAR 186
   FILETEST.READERSTATETEST 2 LOCALEFALSE CHAR 192
   FILETEST.READERSTATETEST 3 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ; Test: a UTF-8 BOM with nothing after it.
   ; This should be interpreted as an empty file.
   WRITEBINARYDATA :filename (WORD CHAR 239 CHAR 187 CHAR 191)
   OPENREAD :filename
   SETREAD  :filename
   FILETEST.READERSTATETEST 0 LOCALETRUE  []
   SETREAD []
   CLOSE :filename

   ERASEFILE :filename
END

TO FILETEST.COPYTEXTTOCLIPBOARD :text
   ; Native code to copy data to the clipboard.

   ; size_t bufferLength = (wcslen(:text) + 1) * sizeof(wchar_t)
   LOCALMAKE "bufferLength  PRODUCT 2 SUM 1 COUNT :text

   LOCALMAKE "hMem GLOBALALLOC :text :bufferLength

   LOCALMAKE "CF_UNICODETEXT 13
   SETCLIPBOARDDATA :CF_UNICODETEXT :hMem

   GLOBALFREE :hMem
END


TO FILETEST.COPYTEXTFROMCLIPBOARD
   ; Native code to read text data from the clipboard.
   LOCAL [isOk CF_UNICODETEXT hText clipboardBuffer bufferSize contents]

   ; BOOLEAN isOk = OpenClipboard(NULL);
   DLLLOAD "user32.dll
   MAKE "isOk FIRST DLLCALL [L OpenClipboard L 0]
   IFELSE :isOk = 0 [
      MAKE "contents [] ; cannot open clipboard
   ][
      ; HANDLE hText = ::GetClipboardData(CF_UNICODETEXT);
      MAKE "CF_UNICODETEXT 13
      MAKE "hText FIRST DLLCALL (LIST "L "GetClipboardData "L :CF_UNICODETEXT)
      IFELSE EQUAL? :hText 0 [
         MAKE "contents [] ; clipboard doesn't hold text.
      ][
         ; PVOID clipboardBuffer = GlobalLock(hText);
         DLLLOAD "kernel32.dll
         MAKE "clipboardBuffer FIRST DLLCALL (LIST "L "GlobalLock "L :hText)

         ; int bufferSize = GlobalSize(HText);
         MAKE "bufferSize FIRST DLLCALL (LIST "L "GlobalSize "L :hText);

         ; Copy everything except the trailing NUL character (-2).
         ; wchar_t * contents = malloc(bufferSize - 2)
         ; memcpy(contents, clipboardBuffer, bufferSize - 2);
         DLLLOAD "msvcrt.dll
         MAKE "contents FIRST DLLCALL (
            LIST "V "memcpy
                 "L (:bufferSize - 2)  ; length
                 "L :clipboardBuffer   ; source
                 "B (:bufferSize - 2)  ; malloc+dest
         )
         (DLLFREE "msvcrt.dll)

         ; GlobalUnlock(hText);
         DLLCALL (LIST "V "GlobalUnlock "L :hText)
         (DLLFREE "kernel32.dll)
      ]

      ; CloseClipboard();
      DLLCALL [V CloseClipboard]
   ]
   (DLLFREE "user32.dll)

   IF WORD? :contents [
      ; Because we requested the data as CF_UNICODETEXT, we must convert it
      ; from a sequence of UTF16LE bytes into native Unicode.
      MAKE "contents CONVERTUTF16LEWORD :contents
   ]

   OUTPUT :contents
END

TO FILETEST.OPENREAD.CLIPBOARD.TEXT
   ; Tests that OPENREAD can read from the clipboard.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Write some known data to the clipboard, replacing whatever is there.
   FILETEST.COPYTEXTTOCLIPBOARD (WORD
     "Hello CHAR 13 CHAR 10
     "Clipboard CHAR 13 CHAR 10
     "|Good Bye|
   )

   ; Now, read from the clipboard
   OPENREAD "clipboard

   ; The file should have been added to the "open file" list.
   FAILIFNOTTRUE [ MEMBERP "clipboard ALLOPEN ]

   SETREAD  "clipboard

   SIMPLEREPORTTEST [READPOS] 0
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READPOS] 10 ; BOM (2) + hello (5) + CRLF (2)
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [Clipboard]
   SIMPLEREPORTTEST [READPOS] 21 ; 10 + clipboard (9) + CRLF (2)
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [Good Bye]
   SIMPLEREPORTTEST [READPOS] 29 ; 21 + Good Bye (8)
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "clipboard

   ; Reading from the clipboard should not have changed it.
   ; That is, we should be able to read the exact same content.
   OPENREAD "clipboard
   SETREAD  "clipboard

   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READPOS] 10
   SIMPLEREPORTTEST [READLIST] [Clipboard]
   SIMPLEREPORTTEST [READPOS] 21
   SIMPLEREPORTTEST [READLIST] [Good Bye]
   SIMPLEREPORTTEST [READPOS] 29
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "clipboard
END

TO FILETEST.OPENREAD.CLIPBOARD.UNICODECONTENT
   ; Tests that OPENREAD can read non-ASCII text from the clipboard.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Write some known data to the clipboard, replacing whatever is there.
   FILETEST.COPYTEXTTOCLIPBOARD (WORD
     "|Sigma | CHAR 931   CHAR 13 CHAR 10
     "|Aleph | CHAR 1488  CHAR 13 CHAR 10
   )

   ; Now, read from the clipboard
   OPENREAD "clipboard
   SETREAD  "clipboard

   SIMPLEREPORTTEST [READPOS] 0
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READWORD] (WORD "|Sigma | CHAR 931)
   SIMPLEREPORTTEST [READPOS] 13 ; BOM (3) + text (8) + CRLF (2)
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READWORD] (WORD "|Aleph | CHAR 1488)
   SIMPLEREPORTTEST [READPOS] 23 ; 13 + text (8) + CRLF (2)
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "clipboard

   ; Reading from the clipboard should not have changed it.
   ; That is, we should be able to read the exact same content.
   OPENREAD "clipboard
   SETREAD  "clipboard

   SIMPLEREPORTTEST [READPOS] 0
   SIMPLEREPORTTEST [READWORD] (WORD "|Sigma | CHAR 931)
   SIMPLEREPORTTEST [READPOS] 13
   SIMPLEREPORTTEST [READWORD] (WORD "|Aleph | CHAR 1488)
   SIMPLEREPORTTEST [READPOS] 23
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "clipboard
END

TO FILETEST.OPENREAD.CLIPBOARD.BINARYMODE
   ; Tests that OPENREAD can read from the clipboard in binary mode.
   ; This is a regression test for bug #530 (access violation)
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Copy some known data to the clipboard, replacing whatever is there.
   FILETEST.COPYTEXTTOCLIPBOARD (WORD
     "Hello     CHAR 13 CHAR 10
     "|Good Bye|
   )

   ; Open the clipboard for binary reading
   TRACEINSTRUCTION [ (OPENREAD "clipboard LOCALETRUE) ]

   TRACEINSTRUCTION [ SETREAD  "clipboard ]

   ; Read the contents of the clipboard.
   FILETEST.READERSTATETEST  0 LOCALEFALSE 239       ; UTF-8 BOM byte 1
   FILETEST.READERSTATETEST  1 LOCALEFALSE 187       ; UTF-8 BOM byte 2
   FILETEST.READERSTATETEST  2 LOCALEFALSE 191       ; UTF-8 BOM byte 3
   FILETEST.READERSTATETEST  3 LOCALEFALSE ASCII "H
   FILETEST.READERSTATETEST  4 LOCALEFALSE ASCII "e
   FILETEST.READERSTATETEST  5 LOCALEFALSE ASCII "l
   FILETEST.READERSTATETEST  6 LOCALEFALSE ASCII "l
   FILETEST.READERSTATETEST  7 LOCALEFALSE ASCII "o
   FILETEST.READERSTATETEST  8 LOCALEFALSE 13
   FILETEST.READERSTATETEST  9 LOCALEFALSE 10
   FILETEST.READERSTATETEST 10 LOCALEFALSE ASCII "G
   FILETEST.READERSTATETEST 11 LOCALEFALSE ASCII "o
   FILETEST.READERSTATETEST 12 LOCALEFALSE ASCII "o
   FILETEST.READERSTATETEST 13 LOCALEFALSE ASCII "d
   FILETEST.READERSTATETEST 14 LOCALEFALSE ASCII "| |
   FILETEST.READERSTATETEST 15 LOCALEFALSE ASCII "B
   FILETEST.READERSTATETEST 16 LOCALEFALSE ASCII "y
   FILETEST.READERSTATETEST 17 LOCALEFALSE ASCII "e
   FAILIFNOTTRUE [EOFP]

   ; Close the file
   TRACEINSTRUCTION [ SETREAD [] ]
   TRACEINSTRUCTION [ CLOSE "clipboard ]

   ; Reading from the clipboard in binary mode should not have changed it.
   ; That is, we should be able to read the exact same content.
   TRACEINSTRUCTION [ OPENREAD "clipboard ]
   TRACEINSTRUCTION [ SETREAD  "clipboard ]

   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READPOS]  10
   SIMPLEREPORTTEST [READLIST] [Good Bye]
   SIMPLEREPORTTEST [READPOS]  18
   FAILIFNOTTRUE    [EOFP]

   TRACEINSTRUCTION [ SETREAD []       ]
   TRACEINSTRUCTION [ CLOSE "clipboard ]
END

TO FILETEST.OPENREAD.CLIPBOARD.NONTEXT
   ; Tests when OPENREAD reads from the clipboard and it doesn't contain text.

   ; Copy a bit map to the clipboard
   SETBITINDEX 0
   BITCOPY 100 100

   ; Now, read from the clipboard
   OPENREAD "clipboard
   SETREAD  "clipboard

   SIMPLEREPORTTEST [READPOS] 0
   FAILIFNOTFALSE   [EOFP]

   SIMPLEREPORTTEST [READLIST] [No Text in Clipboard]
   SIMPLEREPORTTEST [READPOS] 23 ; BOM (3) + text (20)
   FAILIFNOTTRUE    [EOFP]

   SETREAD []
   SIMPLEREPORTTEST [READER] []

   CLOSE "clipboard
END

TO FILETEST.OPENREAD.CLIPBOARD.CASEINSENSITIVE
   ; Tests that the name of the special file "clipboard is case insensitive
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Write some known data to the clipboard, replacing whatever is there.
   FILETEST.COPYTEXTTOCLIPBOARD (WORD
     "Hello CHAR 13 CHAR 10
     "|Good Bye|
   )

   ; Open the file with strange capitialization
   OPENREAD "ClipBOARD

   ; Try to set the reader using a different case.
   ; This should fail (with no side-effects)
   LOCALMAKE "oldreader READER
   RUNFILESYSTEMERRORTEST [SETREAD "CLIPBOARD]
   SIMPLEREPORTTEST [READER] :oldreader

   ; Set the reader with the same capitalization.
   SETREAD  "ClipBOARD

   ; Read the clipboard
   SIMPLEREPORTTEST [READPOS] 0
   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READLIST] [Good Bye]
   FAILIFNOTTRUE    [EOFP]

   ; Try to close the file with different capitialization.
   ; This should fail (with no side-effects)
   RUNFILESYSTEMERRORTEST [CLOSE "CLIPBOARD]
   SIMPLEREPORTTEST [READER] "ClipBOARD

   ; Close the clipboard the same capitialization
   CLOSE "ClipBOARD
END

TO FILETEST.OPENREAD.EMPTYFILE
   ; Tests the behavior of OPENREAD when reading empty file (zero bytes)

   ; Create an empty file.
   WRITEBINARYDATA "empty.txt "||

   ; Read the empty file
   TRACEINSTRUCTION [ OPENREAD "empty.txt ]
   TRACEINSTRUCTION [ SETREAD  "empty.txt ]

   ; The file should be immediately recognized as empty.
   FILETEST.READERSTATETEST 0 LOCALETRUE []

   ; After failing to read a character, the stream should
   ; still be at the end of the file.
   FILETEST.READERSTATETEST 0 LOCALETRUE []

   SETREAD []
   CLOSE "empty.txt

   ; Cleanup
   ERASEFILE "empty.txt
END

TO FILETEST.OPENREAD.NOFILE
   ; Calls OPENREAD with the filename of a non-existing file.

   ; Make sure the file doesn't exist.
   TRACEINSTRUCTION [ ERASEFILE "filetest.openread.doesnotexist ]

   ; OPENREAD should throw an error
   RUNFILESYSTEMERRORTEST [ OPENREAD "filetest.openread.doesnotexist ]

   ; The file should not be open
   FAILIFNOTFALSE [ MEMBERP "filetest.openread.doesnotexist ALLOPEN ]
END

TO FILETEST.OPENREAD.SETWRITE
   ; Attempts to write to a file that was open for reading.
   LOCALMAKE "filename "filetest.openread.setwrite.txt

   ; Populate some content in the file.
   OPENWRITE :filename
   SETWRITE  :filename
   PRINT [This is the original content of a test file.]
   SETWRITE []
   CLOSE :filename

   ; Open the existing file with OPENREAD.
   TRACEINSTRUCTION [ OPENREAD :filename ]

   ; Try to write to the file.
   ; For legacy reasons, this acts as a no-op, instead of being
   ; an error.
   TRACEINSTRUCTION [ SETWRITE :filename ]
   SIMPLEREPORTTEST [ WRITER   ] :filename
   SIMPLEREPORTTEST [ WRITEPOS ] 0
   TRACEINSTRUCTION [ PRINT [Some new content] ]
   SIMPLEREPORTTEST [ WRITEPOS ] 21 ; WRITEPOS thinks it worked

   TRACEINSTRUCTION [ SETWRITEPOS 10 ] ; seeking thinks it works
   SIMPLEREPORTTEST [ WRITEPOS  ] 10
   TRACEINSTRUCTION [ PRINT [NEW CONTENT] ]

   SETWRITE []
   CLOSE :filename

   ; Despite there being no errors when printing, nothing was written.
   OPENREAD :filename
   SETREAD :filename
   SIMPLEREPORTTEST [READLIST] [This is the original content of a test file.]
   SIMPLEREPORTTEST [READLIST] "||
   FAILIFNOTTRUE    [EOF?]
   SETREAD []
   CLOSE :filename

   ; Cleanup
   ERASEFILE :filename
END

TO FILETEST.OPENWRITE.CLIPBOARD.TEXT
   ; Tests that OPENWRITE can write to the clipboard.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Write to the clipboard
   TRACEINSTRUCTION [ OPENWRITE "clipboard ]
   TRACEINSTRUCTION [ SETWRITE  "clipboard ]
   TRACEINSTRUCTION [ PRINT "Hello         ]
   TRACEINSTRUCTION [ PRINT [Good Bye]     ]
   TRACEINSTRUCTION [ SETWRITE []          ]
   TRACEINSTRUCTION [ CLOSE "clipboard     ]

   ; Read the contents directly from the clipboard.
   SIMPLEREPORTTEST [ FILETEST.COPYTEXTFROMCLIPBOARD ] (WORD
     "Hello      CHAR 13 CHAR 10
     "|Good Bye| CHAR 13 CHAR 10)

   ; Read the contents through the file API
   TRACEINSTRUCTION [ OPENREAD "clipboard ]
   TRACEINSTRUCTION [ SETREAD  "clipboard ]
   SIMPLEREPORTTEST [READLIST] [Hello]
   SIMPLEREPORTTEST [READLIST] [Good Bye]
   TRACEINSTRUCTION [ SETREAD []       ]
   TRACEINSTRUCTION [ CLOSE "clipboard ]
END

TO FILETEST.OPENWRITE.CLIPBOARD.UNICODECONTENT
   ; Tests that OPENWRITE can write non-ASCII text to the clipboard.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

   ; Write some data to the clipboard, expecting it to be replaced.
   FILETEST.COPYTEXTTOCLIPBOARD "|Some Text To Be Replaced|

   ; Write some unicode content to the clipboard, replacing whatever is there.
   TRACEINSTRUCTION [ OPENWRITE "clipboard               ]
   TRACEINSTRUCTION [ SETWRITE  "clipboard               ]
   TRACEINSTRUCTION [ PRINT WORD "|Sigma: |    CHAR 931  ]
   TRACEINSTRUCTION [ PRINT WORD "|Aleph: |    CHAR 1488 ]
   TRACEINSTRUCTION [ PRINT WORD "|Shamrock: | CHAR 9752 ]
   TRACEINSTRUCTION [ SETWRITE []                        ]
   TRACEINSTRUCTION [ CLOSE "clipboard                   ]

   ; Read the contents directly from the clipboard.
   SIMPLEREPORTTEST [ FILETEST.COPYTEXTFROMCLIPBOARD ] (WORD
     "|Sigma: |    CHAR 931     CHAR 13 CHAR 10
     "|Aleph: |    CHAR 1488    CHAR 13 CHAR 10
     "|Shamrock: | CHAR 9752    CHAR 13 CHAR 10
   )

   ; Read the contents through the file API
   TRACEINSTRUCTION [ OPENREAD "clipboard ]
   TRACEINSTRUCTION [ SETREAD  "clipboard ]
   SIMPLEREPORTTEST [READWORD] WORD "|Sigma: |    CHAR 931
   SIMPLEREPORTTEST [READWORD] WORD "|Aleph: |    CHAR 1488
   SIMPLEREPORTTEST [READWORD] WORD "|Shamrock: | CHAR 9752
   SIMPLEREPORTTEST [READWORD] []
   TRACEINSTRUCTION [ SETREAD [] ]
   TRACEINSTRUCTION [ CLOSE "clipboard ]
END

TO FILETEST.OPENWRITE.CLIPBOARD.NONTEXT
   ; Tests when OPENWRITE writes to the clipboard when it doesn't contain text.
   IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

