LOAD "testlib.lgo

TO BURYTEST.BURYBEFOREDEFINED.PROCEDURE
   ; Make sure that the procedure-to-bury does not already exist.
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE PROCEDURES ]

   ; Tests that a procedure can be marked as buried, even before it's defined.
   TRACEINSTRUCTION [ BURY "BURYTEST.NEWPROCEDURE ]

   ; The buried procedure doesn't appear as buried until it exists.
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE PROCEDURES ]

   ; DEFINE the buried procedure (no inputs, no body).
   TRACEINSTRUCTION [ DEFINE "BURYTEST.NEWPROCEDURE [[]] ]

   ; The buried procedure should now appear as buried.
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.NEWPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE PROCEDURES ]

   ; ERASE the buried procedure.
   TRACEINSTRUCTION [ ERASE "BURYTEST.NEWPROCEDURE ]

   ; The buried procedure should no longer appear as buried.
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE PROCEDURES ]

   ; DEFINE the procedure (again)
   TRACEINSTRUCTION [ DEFINE "BURYTEST.NEWPROCEDURE [[]] ]

   ; The buried procedure should still appear as buried.
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.NEWPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.NEWPROCEDURE PROCEDURES ]

   ; Cleanup
   TRACEINSTRUCTION [ ERASE "BURYTEST.NEWPROCEDURE  ]
   TRACEINSTRUCTION [ UNBURY "BURYTEST.NEWPROCEDURE ]
END

TO BURYTEST.BURYBEFOREDEFINED.VARIABLE
   ; Make sure that the variable-to-bury does not already exist.
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 CONTENTS) ]

   ; Tests that a variable can be marked as buried, even before it's defined.
   TRACEINSTRUCTION [ BURY [[] [burytest.newvariable] ] ]

   ; The buried variable doesn't appear as buried until it exists.
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 BURIED)   ]
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 CONTENTS) ]

   ; MAKE the buried variable.
   TRACEINSTRUCTION [ MAKE "burytest.newvariable 123 ]

   ; The buried variable should now appear as buried.
   FAILIFNOTTRUE  [MEMBERP "burytest.newvariable (ITEM 2 BURIED)   ]
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 CONTENTS) ]

   ; ERASE the buried variable.
   TRACEINSTRUCTION [ ERASE [[] [burytest.newvariable] ] ]

   ; The buried variable should no longer appear as buried.
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 BURIED)   ]
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 CONTENTS) ]

   ; Create a LOCAL scope for the varible.
   LOCAL "burytest.newvariable

   ; A variable with a scope but no definition does not appear as buried.
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "steptest.newvariable (ITEM 2 CONTENTS) ]

   ; Assign a value to the variable.
   TRACEINSTRUCTION [ MAKE "burytest.newvariable [] ]

   ; The variable should now appear as buried, now that it has a value.
   FAILIFNOTTRUE  [MEMBERP "burytest.newvariable (ITEM 2 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "burytest.newvariable (ITEM 2 CONTENTS) ]

   ; Cleanup
   TRACEINSTRUCTION [ UNBURY [[] [burytest.newvarible] ] ]
END

TO BURYTEST.BURYBEFOREDEFINED.PLIST
   ; Make sure that the property list to bury does not already exist.
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Test that a property list can be marked as buried, even before it's created.
   TRACEINSTRUCTION [ BURY [[] [] [burytest.newpropertylist]] ]

   ; The buried property list doesn't appear as buried until it exists.
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Create the buried property list
   TRACEINSTRUCTION [ PPROP "burytest.newpropertylist "property [] ]

   ; The buried property list should now appear as buried.
   FAILIFNOTTRUE  [MEMBERP "burytest.newpropertylist (ITEM 3 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Remove the property from the buried property list
   TRACEINSTRUCTION [ REMPROP "burytest.newpropertylist "property ]

   ; The buried property list should no longer appear as buried.
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Recreate the property list
   TRACEINSTRUCTION [ PPROP "burytest.newpropertylist "property 0 ]

   ; The buried property list should once again appear as buried.
   FAILIFNOTTRUE  [MEMBERP "burytest.newpropertylist (ITEM 3 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "burytest.newpropertylist (ITEM 3 CONTENTS) ]

   ; Cleanup
   TRACEINSTRUCTION [ REMPROP "burytest.newpropertylist "property ]
   TRACEINSTRUCTION [ UNBURY [[] [] [burytest.newpropertylist]]   ]
END


TO BURYTEST.BURIEDPROCEDURE
   ; This procedure exists only to be buried.
END

TO BURYTEST.PROCEDURE

   ; make sure the procedure exists and is not buried
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPROCEDURE PROCEDURES      ]

   ; bury the procedure
   TRACEINSTRUCTION [BURY "BURYTEST.BURIEDPROCEDURE]

   ; make sure the procedure is buried
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPROCEDURE PROCEDURES      ]

   ; make sure the buried procedure is still callable
   TRACEINSTRUCTION [BURYTEST.BURIEDPROCEDURE]

   ; unbury the procedure
   TRACEINSTRUCTION [UNBURY "BURYTEST.BURIEDPROCEDURE]

   ; make sure the procedure is not buried anymore
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPROCEDURE (ITEM 1 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPROCEDURE PROCEDURES      ]

END


TO BURYTEST.VARIABLE

   LOCALMAKE "BURYTEST.BURIEDVARIABLE 123

   ; make sure the variable exists and is not buried
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 NAMES)  ]

   ; bury the variable
   TRACEINSTRUCTION [BURY NAMELIST "BURYTEST.BURIEDVARIABLE]

   ; make sure the variable is buried
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 NAMES)  ]

   ; make sure the buried variable can still be used
   FAILIFNOTTRUE [:BURYTEST.BURIEDVARIABLE = 123]

   ; unbury the variable
   TRACEINSTRUCTION [UNBURY NAMELIST "BURYTEST.BURIEDVARIABLE]

   ; make sure the variable is not buried anymore
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDVARIABLE (ITEM 2 NAMES)  ]

END

TO BURYTEST.PROPERTYLIST

   ; create the propery list
   TRACEINSTRUCTION [PPROP "BURYTEST.BURIEDPLIST "SOMEPROPERTY 123 ]

   ; make sure the propery list is not already stepped
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 PLISTS) ]

   ; step the propery list
   TRACEINSTRUCTION [BURY PLLIST "BURYTEST.BURIEDPLIST]

   ; make sure the propery list is buried
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 BURIED) ]
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 PLISTS) ]

   ; make sure the property list is still accessible
   SIMPLEREPORTTEST [GPROP "BURYTEST.BURIEDPLIST "SOMEPROPERTY] 123

   ; unbury the propery list
   TRACEINSTRUCTION [UNBURY PLLIST "BURYTEST.BURIEDPLIST]

   ; make sure the propery list is not buried anymore
   FAILIFNOTFALSE [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 BURIED) ]
   FAILIFNOTTRUE  [MEMBERP "BURYTEST.BURIEDPLIST (ITEM 3 PLISTS) ]

   ; cleanup
   ERASE PLLIST "BURYTEST.BURIEDPLIST

END

TO BURYTEST.BURYALL

   ; determine the real workspace contents
   BURYALL                    ; make sure BURYALL is loaded
   UNBURYALL                  ; move everything into CONTENTS
   LOCALMAKE "realcontents [] ; create a local so it will be in CONTENTS
   LOCALMAKE "instruction  [] ; create a local so it will be in CONTENTS
   MAKE "realcontents CONTENTS
 
   ; bury everything
   TRACEINSTRUCTION [BURYALL]

   ; Verify that everything in the workspace is buried.
   ; We don't test the side effect of BURYALL with something like
   ;   SIMPLEREPORTTEST [BURIED] :realcontents
   ; because that logs a line to the test log that is so long that
   ; side-by-side diff tools can't show them.
   ; Instead, we test it in an equivalent way that doesn't log as much.
   FAILIFNOTTRUE [EQUALP BURIED :realcontents ]

   ; SIMPLEREPORTTEST defines local variables, so it will change CONTENTS.
   ; Therefore we do the comparison ourselves.
   IFELSE CONTENTS = [[][][]] [
      REPORTTESTPASSED [CONTENTS returned [[][][]], as expected.]
   ] [
      REPORTTESTPASSED [CONTENTS did not return [[][][]]]
   ]

   ; unbury everything
   UNBURYALL
   REPORTTESTINFO [Called UNBURYALL]

   SIMPLEREPORTTEST [BURIED] [[][][]]
END

TO BURYTEST.BADINPUT

   RUNTOOMANYINPUTSTEST [(BURIED "toomany)]

   TRACEINSTRUCTION       [(BURY [[nonexistent] [nonexistent] [nonexistent]])]
   RUNNOTENOUGHINPUTSTEST [(BURY)]
   RUNTOOMANYINPUTSTEST   [(BURY "name "toomany)]
   RUNBADINPUTTEST        [(BURY {name})]
   RUNBADINPUTTEST        [(BURY [[a][b]{c}])]
   RUNBADINPUTTEST        [(BURY [a b {c}])]
   RUNBADINPUTTEST        [(BURY [[a b {c}]])]
   RUNBADINPUTTEST        [(BURY [[a][b][c][d]])]
   RUNBADINPUTTEST        [(BURY [[[a]]])]

   TRACEINSTRUCTION       [(UNBURY [[nonexistent] [nonexistent] [nonexistent]])]
   RUNNOTENOUGHINPUTSTEST [(UNBURY)]
   RUNTOOMANYINPUTSTEST   [(UNBURY "name "toomany)]
   RUNBADINPUTTEST        [(UNBURY {name})]
   RUNBADINPUTTEST        [(UNBURY [[a][b]{c}])]
   RUNBADINPUTTEST        [(UNBURY [a b {c}])]
   RUNBADINPUTTEST        [(UNBURY [[a b {c}]])]
   RUNBADINPUTTEST        [(UNBURY [[a][b][c][d]])]
   RUNBADINPUTTEST        [(UNBURY [[[a]]])]

   RUNTOOMANYINPUTSTEST [(BURYALL "toomany)]

   RUNTOOMANYINPUTSTEST [(UNBURYALL "toomany)]
END

TO BURYTEST

   ; backup the set of things that are buried
   LOCALMAKE "savedburied BURIED

   BURYTEST.PROCEDURE
   BURYTEST.VARIABLE
   BURYTEST.PROPERTYLIST
   BURYTEST.BADINPUT
   BURYTEST.BURYALL
   BURYTEST.BURYBEFOREDEFINED.PROCEDURE
   BURYTEST.BURYBEFOREDEFINED.VARIABLE
   BURYTEST.BURYBEFOREDEFINED.PLIST

   ; restore the set of things that are buried
   UNBURYALL
   BURY :savedburied

END
