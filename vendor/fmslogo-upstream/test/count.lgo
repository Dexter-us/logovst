LOAD "testlib.lgo

TO COUNTTEST.SMOKETEST
  SIMPLEREPORTTEST [ COUNT "abc    ] 3
  SIMPLEREPORTTEST [ COUNT [a b c] ] 3
  SIMPLEREPORTTEST [ COUNT {a b c} ] 3
END


TO COUNTTEST.WORD

  SIMPLEREPORTTEST [ COUNT "       ] 0
  SIMPLEREPORTTEST [ COUNT "a      ] 1
  SIMPLEREPORTTEST [ COUNT "ab     ] 2
  SIMPLEREPORTTEST [ COUNT "abc    ] 3
  SIMPLEREPORTTEST [ COUNT "|abc|  ] 3
  SIMPLEREPORTTEST [ COUNT "|a:c|  ] 3
  SIMPLEREPORTTEST [ COUNT "\a\:\c ] 3
  SIMPLEREPORTTEST [ COUNT 999     ] 3
  SIMPLEREPORTTEST [ COUNT 99.90   ] 4

  ; Doesn't stop at NUL 
  SIMPLEREPORTTEST [ COUNT (WORD "a CHAR 0 "c) ] 3

  ; Non-ASCII
  SIMPLEREPORTTEST [ COUNT (WORD CHAR 1234 CHAR 4567 CHAR 8910) ] 3

  ; A word that looks like a list (not re-parsed)
  SIMPLEREPORTTEST [ COUNT "|[a b c]|  ] 7 ; still a word

END


TO COUNTTEST.LIST
  SIMPLEREPORTTEST [ COUNT []         ] 0
  SIMPLEREPORTTEST [ COUNT [a]        ] 1
  SIMPLEREPORTTEST [ COUNT [ab c]     ] 2
  SIMPLEREPORTTEST [ COUNT [a b c]    ] 3
  SIMPLEREPORTTEST [ COUNT [[a b c]]  ] 1
  SIMPLEREPORTTEST [ COUNT [{a b c}]  ] 1
  SIMPLEREPORTTEST [ COUNT [[] [] []] ] 3
END


TO COUNTTEST.ARRAY
  SIMPLEREPORTTEST [ COUNT {}         ] 0
  SIMPLEREPORTTEST [ COUNT {}@10      ] 0
  SIMPLEREPORTTEST [ COUNT {ab c}     ] 2
  SIMPLEREPORTTEST [ COUNT {a b c}    ] 3
  SIMPLEREPORTTEST [ COUNT {a b c}@-5 ] 3
  SIMPLEREPORTTEST [ COUNT {[a b c]}  ] 1
  SIMPLEREPORTTEST [ COUNT {{a b c}}  ] 1
  SIMPLEREPORTTEST [ COUNT {{} {} {}} ] 3
  SIMPLEREPORTTEST [ COUNT ARRAY 10   ] 10
END


TO COUNTTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(COUNT)]
  RUNTOOMANYINPUTSTEST   [(COUNT "a "toomany)]
END


TO COUNTTEST
  COUNTTEST.SMOKETEST
  COUNTTEST.WORD
  COUNTTEST.LIST
  COUNTTEST.ARRAY
  COUNTTEST.BADINPUT
END
