LOAD "testlib.lgo

TO FIRSTSTEST.SMOKETEST

   SIMPLEREPORTTEST [FIRSTS [[1 2 3]]] [1]

   SIMPLEREPORTTEST [FIRSTS [[1 2 3] [a b c] {4 5 6}@0 ]] [1 a 0]
   SIMPLEREPORTTEST [FIRSTS [[1 2 3] hello [1] h {} ]] [1 h 1 h 1]

   ; empty list is valid
   SIMPLEREPORTTEST [FIRSTS []]  []

END

TO FIRSTSTEST.BADINPUT

   ; bad number of inputs
   RUNNOTENOUGHINPUTSTEST [(FIRSTS)]
   RUNTOOMANYINPUTSTEST   [(FIRSTS [[1 2 3]] "toomany)]

   ; bad inputs (a list containing a bad input to FIRST)
   RUNDOESNTLIKEINPUTTEST [FIRSTS "abc                ]
   RUNDOESNTLIKEINPUTTEST [FIRSTS 123                 ]
   RUNDOESNTLIKEINPUTTEST [FIRSTS {a b c}             ]
   RUNDOESNTLIKEINPUTTEST [FIRSTS [ [1 2 3] [] abc ]  ]
   RUNDOESNTLIKEINPUTTEST [FIRSTS (LIST "|| [1 2 3] ) ]

   ; Confirm that the recoverable errors are really recoverable.
   ; The first input is bad, as are all but the final replacement
   RUNRECOVERABLEERRORTEST [
      FIRSTS "abc   ; must be a list
   ](LIST
      123                         ; must be a list
      {1 2 3}                     ; must be a list
      [ [1 2 3] [] [a b c] ]      ; item can't be the empty list
      (LIST "|| [a b c] )         ; item can't be empty word
      "abc                        ; must be a list (again)
      123                         ; must be a list (again)
      {1 2 3}                     ; must be a list (again)
      [ [1 2 3] [] ]              ; item can't be the empty list (again)
      (LIST [1 2 3] "abc "|| )    ; item can't be the empty word (again)
      [ [1 2 3] abc 321 -1.5 {} ] ; legal
   ) ~
   [[1 a 3 - 1]] ; first member of each element

   ; Test that FIRSTS accepts ownership of any node :erract provides.
   LOCAL "erract
   TRACEINSTRUCTION [ MAKE "erract [ (LIST (LIST "allocated "in "FIRSTSTEST.BADINPUT) ) ] ]
   SIMPLEREPORTTESTNOCATCH [ FIRSTS {} ] [allocated]
END

TO FIRSTSTEST

   FIRSTSTEST.SMOKETEST
   FIRSTSTEST.BADINPUT

END
