TO NETWORKTEST.CLIENT.RECEIVEANSI

   LOCAL [remoteport client.data shellcommand windows1252]

   MAKE "remoteport  5555
   MAKE "client.data []

   ; spawn a server
   MAKE "shellcommand NETWORKTEST.SERVERCOMMAND "ansi :remoteport
   FAILIFNOTTRUE (LIST "SHELL :shellcommand)

   ; wait a second for the server to come online
   TRACEINSTRUCTION [ WAIT 60 ]

   ; connect the client to the server
   TRACEINSTRUCTION [ NETSTARTUP ]
   FAILIFNOTTRUE [ 
      NETCONNECTON
         "localhost
         :remoteport
         []
         [QUEUE "client.data NETCONNECTRECEIVEVALUE]
   ]

   ; wait two seconds for the network connection
   TRACEINSTRUCTION  [ WAIT 60*2 ]

   TRACEINSTRUCTION  [ NETCONNECTOFF ]
   TRACEINSTRUCTION  [ NETSHUTDOWN   ]

   ; A sequence of bytes from 0x80 - 0xFF.
   ; How FMSLogo interpretes these depends on the system code page.
   MAKE "windows1252 APPLY "WORD MAP "CHAR [
      8364  129 8218  402 8222 8230 8224 8225 710 8240 352 8249 338 141 381 143
      144  8216 8217 8220 8221 8226 8211 8212 732 8482 353 8250 339 157 382 376
      160   161  162  163  164  165  166  167 168  169 170  171 172 173 174 175
      176   177  178  179  180  181  182  183 184  185 186  187 188 189 190 191
      192   193  194  195  196  197  198  199 200  201 202  203 204 205 206 207
      208   209  210  211  212  213  214  215 216  217 218  219 220 221 222 223
      224   225  226  227  228  229  230  231 232  233 234  235 236 237 238 239
      240   241  242  243  244  245  246  247 248  249 250  251 252 253 254 255
   ]
   SIMPLEREPORTTEST [:client.data] (LIST (LIST :windows1252))
END

TO NETWORKTEST.CLIENT.REMOTERESETAFTERCONNECT
   ; Test when a remote server closes the connection with the RST flag.

   LOCAL [remoteport client.data shellcommand onsendreadycounter]

   MAKE "remoteport         5556
   MAKE "client.data        []
   MAKE "onsendreadycounter 0

   ; spawn a server
   MAKE "shellcommand NETWORKTEST.SERVERCOMMAND "fastreset :remoteport
   FAILIFNOTTRUE (LIST "SHELL :shellcommand)

   ; wait a second for the server to come online
   TRACEINSTRUCTION [ WAIT 60 ]

   ; Connect the client to the server.
   TRACEINSTRUCTION [ NETSTARTUP ]
   FAILIFNOTTRUE [ 
      NETCONNECTON
         "localhost
         :remoteport
         [ MAKE "onsendreadycounter :onsendreadycounter + 1 ]
         [QUEUE "client.data NETCONNECTRECEIVEVALUE]
   ]

   ; Wait a second for the network connection to be established
   TRACEINSTRUCTION  [ WAIT 60 ]

   TRACEINSTRUCTION  [ NETCONNECTOFF ]
   TRACEINSTRUCTION  [ NETSHUTDOWN   ]

   ; Confirm that no data was returned.
   SIMPLEREPORTTEST [:client.data] []

   ; Confirm that the sendready callback was called three times.
   SIMPLEREPORTTEST [:onsendreadycounter] 3
END

TO NETWORKTEST.CLIENT.REMOTERESETAFTERSEND
   ; Test when a remote server closes the connection with the RST flag
   ; after it receives some data.

   LOCAL [remoteport client.data shellcommand onsendreadycounter]

   MAKE "remoteport         5557
   MAKE "client.data        []
   MAKE "onsendreadycounter 0

   ; spawn a server
   MAKE "shellcommand NETWORKTEST.SERVERCOMMAND "slowreset :remoteport
   FAILIFNOTTRUE (LIST "SHELL :shellcommand)

   ; wait a second for the server to come online
   TRACEINSTRUCTION [ WAIT 60 ]

   ; Connect the client to the server.
   TRACEINSTRUCTION [ NETSTARTUP ]
   FAILIFNOTTRUE [
      NETCONNECTON
         "localhost
         :remoteport
         [ MAKE "onsendreadycounter :onsendreadycounter + 1
           IF :onsendreadycounter = 3 [ IGNORE NETCONNECTSENDVALUE "data ]
         ]
         [QUEUE "client.data NETCONNECTRECEIVEVALUE]
   ]

   ; Wait a second for the network connection to be established
   TRACEINSTRUCTION  [ WAIT 60 ]


   TRACEINSTRUCTION  [ NETCONNECTOFF ]
   TRACEINSTRUCTION  [ NETSHUTDOWN   ]

   ; Confirm that no data was returned.
   SIMPLEREPORTTEST [:client.data] []

   ; Confirm that the sendready callback was called three times.
   SIMPLEREPORTTEST [:onsendreadycounter] 3
END


TO NETWORKTEST.SERVER.SHUTDOWNRACE

   ; start the network system
   TRACEINSTRUCTION [ NETSTARTUP ]

   ; Start a server.  This schedules an asynchronous callback.
   FAILIFNOTTRUE [ NETACCEPTON 12345 [] [] ]

   ; Immediately shutdown (before the server's sendready gets called)
   ; This forces a race condition where the WSAAsyncGetHostByName message
   ; comes in after the network subsystem has been shut down.
   ; This is a regression test for Bug #181, which is a crash.
   TRACEINSTRUCTION [ NETSHUTDOWN ]

END

TO NETWORKTEST.CLIENT.SHUTDOWNRACE

   ; start the network system
   TRACEINSTRUCTION  [ NETSTARTUP ]

   ; make an outbound connection.  Because this is asynchronous, 
   ; we don't even need a server, we are going to shutdown before
   ; the call to connect() is made.
   FAILIFNOTTRUE [ NETCONNECTON "localhost 4444 [] [] ]

   ; Immediately shutdown (before the client's sendready gets called).
   ; This forces a race condition where the WSAAsyncGetHostByName message
   ; comes in after the network subsystem has been shut down.
   ; This is a regression test for bug #181, which is a crash.
   TRACEINSTRUCTION [ NETSHUTDOWN ]
END

TO NETWORKTEST.BADINPUT

   ; Start with the network off.
   ; If the network isn't started, this is a no-op.
   TRACEINSTRUCTION [ NETSHUTDOWN ]

   ; Try to connect/accept/send/receive when the network isn't started.
   NETWORKTEST.RUNNETWORKNOTSTARTEDTEST [ NETCONNECTON "localhost 54321 [] [] ]
   TRACEINSTRUCTION [ NETCONNECTOFF ]             ; no-op if not running
   FAILIFNOTFALSE   [ NETCONNECTSENDVALUE "data ] ; outputs false for error
   TRACEINSTRUCTION [ NETCONNECTRECEIVEVALUE ]    ; outputs nothing for error
   NETWORKTEST.RUNNETWORKNOTSTARTEDTEST [ NETACCEPTON 54321 [] [] ]
   TRACEINSTRUCTION [ NETACCEPTOFF ]             ; no-op if not running
   FAILIFNOTFALSE   [ NETACCEPTSENDVALUE "data ] ; outputs false for error
   TRACEINSTRUCTION [ NETACCEPTRECEIVEVALUE ]    ; outputs nothing for error

   ; Start the network with synchronous DNS.
   ; This makes some errors synchronous.
   TRACEINSTRUCTION [ (NETSTARTUP 1) ]

   ; Start the network when it's already started.
   NETWORKTEST.RUNNETWORKALREADYSTARTEDTEST [ NETSTARTUP ]

   ; The send/receive procedures still do nothing.
   FAILIFNOTFALSE   [ NETCONNECTSENDVALUE "data ] ; outputs false for error
   TRACEINSTRUCTION [ NETCONNECTRECEIVEVALUE ]    ; output nothing for error
   FAILIFNOTFALSE   [ NETACCEPTSENDVALUE "data ]  ; outputs false for error
   TRACEINSTRUCTION [ NETACCEPTRECEIVEVALUE ]     ; output nothing for error


   ; Test connecting when the port is not a number.
   RUNDOESNTLIKEINPUTTEST [ NETCONNECTON "example.org "notanumber [] [] ]

   ; Test when the host name is unknown.
   ; This is a catch-all for the code path which translates names.
   (RUNEXPECTERRORTEST
      [ NETCONNECTON "does.not.exist.example.org 80 [] [] ]
      1700
      "|Network Error: No data record available|)
   (RUNEXPECTERRORTEST
      [ NETCONNECTON "doesnotexist 80 [] [] ]
      1700
      "|Network Error: Authoritative Answer: Host not found|)

   ; Try to connect to a host/port that isn't listening.
   ; The connection instruction reports a success, but a "connection refused"
   ; error is reported elsewhere.
   FAILIFNOTTRUE [ NETCONNECTON "localhost 54321 [] [] ]

   ; Try to create another connection while the first connection is running.
   NETWORKTEST.RUNNETCONNECTALREADYONTEST [ NETCONNECTON "localhost 54321 [] [] ]

   ; Turn off the connection.
   TRACEINSTRUCTION [ NETCONNECTOFF ]

   ; Other errors
   FAILIFNOTTRUE [ NETCONNECTON "0.0.0.0 54321 [] [] ] ; printed to console
   TRACEINSTRUCTION [ NETCONNECTOFF ]

   ; Listen on a port number that is given as a list.
   RUNDOESNTLIKEINPUTTEST [ NETACCEPTON [8080] [] [] ]

   ; Listen on an impossible port number.
   ; This succeeds (the overflow error is ignored)
   FAILIFNOTTRUE    [ NETACCEPTON 100000 [] [] ]

   ; Try to create another server while the first server is running.
   NETWORKTEST.RUNNETACCEPTALREADYONTEST [ NETACCEPTON "localhost 54322 [] [] ]

   ; Turn off the server.
   TRACEINSTRUCTION [ NETACCEPTOFF ]


   ; Spawn a server to listen on a port
   FAILIFNOTTRUE (LIST "SHELL NETWORKTEST.SERVERCOMMAND "simple 54321)
   TRACEINSTRUCTION [ WAIT 60 ] ; wait a second for the server to come online

   ; Try to listen on the same port in FMSLogo.
   ; This will result in an bind() error.
   (RUNEXPECTERRORTEST
      [ NETACCEPTON 54321 [] [] ]
      1700
      "|Network Error: Address already in use|)

   ; Turn off the external server (by connecting to it)
   FAILIFNOTTRUE [ NETCONNECTON "localhost 54321 [] [] ]



   ; Restart the network with asynchronous DNS.
   ; The main difference is that the instructions report success and
   ; errors are reported asynchronously, where the programmer cannot
   ; get them programmatically.
   TRACEINSTRUCTION [ NETSHUTDOWN   ]
   TRACEINSTRUCTION [ (NETSTARTUP 0) ]

   ; Test connecting when the port is not a number.
   RUNDOESNTLIKEINPUTTEST [ NETCONNECTON "example.org "notanumber [] [] ]

   ; Test when the host name is unknown.
   ; Because DNS is asynchronous, the instruction returns a success code
   ; and the error is reported elsewhere.
   FAILIFNOTTRUE [ NETCONNECTON "does.not.exist.example.org 80 [] [] ]

   ; Try to create another connection while the first connection is running.
   NETWORKTEST.RUNNETCONNECTALREADYONTEST [ NETCONNECTON "localhost 54321 [] [] ]

   ; Turn off the connection.
   TRACEINSTRUCTION [ NETCONNECTOFF ]


   ; Cleanup
   TRACEINSTRUCTION [ NETSHUTDOWN ]

END

TO NETWORKTEST
  IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

  NETWORKTEST.SMOKETEST
  NETWORKTEST.NETSHUTDOWNCRASH

  NETWORKTEST.SERVER.RECEIVEUNFRAMEDPACKET
  NETWORKTEST.SERVER.LISTENAGAIN
  NETWORKTEST.SERVER.TWOCONNECTIONS.SERIAL
  NETWORKTEST.SERVER.TWOCONNECTIONS.CLIENTRESET
  NETWORKTEST.SERVER.TWOCONNECTIONS.CONCURRENT
  NETWORKTEST.SERVER.RECEIVESPECIAL
  NETWORKTEST.SERVER.SHUTDOWNRACE

  NETWORKTEST.CLIENT.SMOKETEST
  NETWORKTEST.CLIENT.ECHO
  NETWORKTEST.CLIENT.ECHO.ANSI
  NETWORKTEST.CLIENT.SENDSPECIAL
  NETWORKTEST.CLIENT.SENDARRAY
  NETWORKTEST.CLIENT.SENDLIST
  NETWORKTEST.CLIENT.RECEIVEUNFRAMEDPACKET
  NETWORKTEST.CLIENT.RECEIVELARGEPACKET
  NETWORKTEST.CLIENT.RECEIVEANSI
  NETWORKTEST.CLIENT.REMOTERESETAFTERCONNECT
  NETWORKTEST.CLIENT.REMOTERESETAFTERSEND
  NETWORKTEST.CLIENT.SHUTDOWNRACE

  NETWORKTEST.BADINPUT

END
