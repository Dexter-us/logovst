LOAD "testlib.lgo

TO FPUTTEST.SMOKETEST

   SIMPLEREPORTTEST [ FPUT  1  [2 3]    ] [1 2 3]
   SIMPLEREPORTTEST [ FPUT  1  []       ] [1]
   SIMPLEREPORTTEST [ FPUT [1] [[2][3]] ] [[1] [2] [3]]


   REPORTTESTINFO [Testing that FPUT can put an array into a list]
   LOCALMAKE "array {1 2 3}
   SIMPLEREPORTTEST [ FPUT :array [1 2 3] ] (LIST :array 1 2 3)


   REPORTTESTINFO [Testing that FPUT isn't destructive]
   LOCALMAKE "originallist [2 3]
   SIMPLEREPORTTEST [ FPUT 1 :originallist ] [1 2 3]
   SIMPLEREPORTTEST [ :originallist ]        [2 3]

END

TO FPUTTEST.BADINPUT

   ; bad number of inputs
   RUNNOTENOUGHINPUTSTEST [(FPUT 3)]
   RUNTOOMANYINPUTSTEST   [(FPUT 3 [1 2] "toomany)]

   ; bad input
   RUNDOESNTLIKEINPUTTEST [ FPUT  3 12    ]
   RUNDOESNTLIKEINPUTTEST [ FPUT "c "ab   ]
   RUNDOESNTLIKEINPUTTEST [ FPUT "3 {1 2} ]
   
   ; Confirm that the recoverable errors are really recoverable.
   ; The first input is bad, as are all but the final replacement
   RUNRECOVERABLEERRORTEST [
      FPUT [] "word ; can't be a word
   ][
      {a b}  ; can't be an array
      123    ; can't be a word (again)
      {}     ; can't be an array (again)
      [1]    ; legal
   ] ~
   [ [ [] 1 ] ] ; NIL put on the front of [1]

   ; Test that FPUT accepts ownership of any node :erract provides.
   LOCAL "erract
   TRACEINSTRUCTION [ MAKE "erract [ (LIST "allocated "in "FPUTTEST.BADINPUT) ] ]
   SIMPLEREPORTTESTNOCATCH [ FPUT 1 {} ] [1 allocated in FPUTTEST.BADINPUT]

END


TO FPUTTEST

   FPUTTEST.SMOKETEST
   FPUTTEST.BADINPUT

END
