   BITLOADTEST.HELPER "valid "8bpp-1x1                      1     1
   BITLOADTEST.HELPER "valid "8bpp-1x64000                  1     64000
   BITLOADTEST.HELPER "valid "8bpp-320x240                  320   240
   BITLOADTEST.HELPER "valid "8bpp-321x240                  321   240
   BITLOADTEST.HELPER "valid "8bpp-322x240                  322   240
   BITLOADTEST.HELPER "valid "8bpp-323x240                  323   240
   BITLOADTEST.HELPER "valid "8bpp-colorsimportant-two      320   240
   BITLOADTEST.HELPER "valid "8bpp-colorsused-zero          320   240
   BITLOADTEST.HELPER "valid "8bpp-topdown-320x240          320   240
   BITLOADTEST.HELPER "valid "rle8-64000x1                  64000 1
   BITLOADTEST.HELPER "valid "rle8-absolute-320x240         320   240
   BITLOADTEST.HELPER "valid "rle8-blank-160x120            160   120
   BITLOADTEST.HELPER "valid "rle8-delta-320x240            320   240
   BITLOADTEST.HELPER "valid "rle8-encoded-320x240          320   240
END

TO BITLOAD.16BPP
   BITLOADTEST.HELPER "valid "555-1x1                       1   1
   BITLOADTEST.HELPER "valid "555-320x240                   320 240
   BITLOADTEST.HELPER "valid "555-321x240                   321 240

   BITLOADTEST.HELPER "valid "565-1x1                       1   1
   BITLOADTEST.HELPER "valid "565-320x240                   320 240
   BITLOADTEST.HELPER "valid "565-321x240                   321 240
   BITLOADTEST.HELPER "valid "565-322x240                   322 240

