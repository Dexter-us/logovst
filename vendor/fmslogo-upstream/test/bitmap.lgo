TO BITLOAD.MISC
   (BITLOADTEST.HELPER "valid "nofileextension      320 240 "||)
   (BITLOADTEST.HELPER "valid "misleadingextension  320 240 ".jpg)
   BITLOADTEST.HELPER "valid "|spaces in  filename| 320 240
END

TO BITLOAD.JPEG
   ; Tests that BITLOAD can be used to load a JPEG.
   CLEARSCREEN

   ; First, test that BITLOADSIZE correctly determines the size of the JPEG.
   ; This image was saved by GIMP.
   SIMPLEREPORTTEST [BITLOADSIZE "heron.jpg] [327 472]

   ; Now, use BITLOAD to load the image to the screen.
   TRACEINSTRUCTION [BITLOAD "heron.jpg]

   ; Confirm that the image was loaded correctly.
   SCROLLY -500
   CHECKSCREEN "heron

   ; Try again with a large JPEG.
   ; This image was created by an old Canon digital camera.
   SIMPLEREPORTTEST [BITLOADSIZE "rainbow.jpg] [640 480]

   ; Now, use BITLOAD to load the image to the screen.
   TRACEINSTRUCTION [BITLOAD "rainbow.jpg]

   ; Confirm that the image was loaded correctly.
   CHECKSCREEN "rainbow

   ; Recenter the scrollbar
   SCROLLY 0
END

TO BITLOADTEST.BE_HAPPY_IF_NO_CRASH :instructions

   REPORTTESTINFO (LIST "Running :instructions)

   ; clear the value of ERROR
   IGNORE ERROR

   ; Run the instructions.
   ; It doesn't matter if it throws an error or not.
   ; The important thing is that it doesn't crash.
   CATCH "ERROR [ 
     IGNORE RUNRESULT :instructions 
     REPORTTESTINFO (LIST "Running :instructions "|did not throw an error.|)
     STOP
   ]

   REPORTTESTINFO (LIST "Running :instructions "|threw an error: | ITEM 2 ERROR)
END

TO BITLOADTEST.MALFORMED.HELPER :type :filename
   ; Determine the location of the test image.
   LOCAL "filepath
   MAKE "filepath (WORD "bmptestsuite-0.9/ :type "/ :filename ".bmp)

   ; As a self-check, make sure that the file exists.
   IF NOT FILEEXISTS :filepath [
      REPORTTESTBUG (WORD "|File "| :filepath "|" doesn't exist in BITLOADTEST.MALFORMED.HELPER|)
      STOP
   ]

   ; Attempt to get the size of the image.
   BITLOADTEST.BE_HAPPY_IF_NO_CRASH (LIST "IGNORE "BITLOADSIZE QUOTED :filepath)

   ; Clear the screen so that whatever is loaded doesn't get confused with
   ; what was previously on the screen.
   CLEARSCREEN

   ; Load the image
   BITLOADTEST.BE_HAPPY_IF_NO_CRASH (LIST "BITLOAD QUOTED :filepath)
END

