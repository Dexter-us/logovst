;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; This file contains tests for the following basic bitmap procedures:
; BITSAVE, BITLOAD, BITLOADSIZE, BITINDEX, SETBITINDEX, BITCOPY, BITCUT,
; BITPASTE, BITPASTETOINDEX, and BITSIZE.
;
; Some tests assume that BITINDEX 41 does not have a valid bitmap.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LOAD "testlib.lgo
LOAD "dllcall/setclipboarddata.lgo

TO BITMAPTEST.RUNCUTFAILEDTEST :instructions
  (RUNEXPECTERRORTEST :instructions 1901 "|Cut failed, possibly not enough memory|)
END

TO BITMAPTEST.RUNNOTHINGTOPASTETEST :instructions
  (RUNEXPECTERRORTEST :instructions 1902 "|Nothing to paste|)
END

TO BITMAPTEST.RUNINDEXOUTOFRANGETEST :instructions
  (RUNEXPECTERRORTEST :instructions 1903 "|BitMap Index out of range|)
END

TO BITMAPTEST.RUNNOTARGETBITMAPTEST :instructions
  (RUNEXPECTERRORTEST :instructions 1904 "|BitMap at Index must be initialized with a bitmap|)
END



TO BITLOADSIZETEST :width :height :bitdepth
  ; this is a regression test for Bug #1

  IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows

  CLEARSCREEN
  HIDETURTLE
  REPEAT 500 [ FORWARD REPCOUNT RIGHT 91 ]
  SHOWTURTLE
  PENUP
  HOME
  PENDOWN

  ; save the bitmap
  LOCALMAKE "oldactivearea ACTIVEAREA
  SETACTIVEAREA (list 0 0 :width :height)
  (BITSAVE "bitmap-test.bmp :bitdepth)

  CLEARSCREEN
  SIMPLEREPORTTEST [ BITLOADSIZE "bitmap-test.bmp ] (list :width :height)

  ; Test that BITLOADSIZE only read the size of the image and draw
  ; it to the screen.
  CHECKSCREEN "blankscreen

  ERASEFILE "bitmap-test.bmp

  ; restore the previous active area
  SETACTIVEAREA :oldactivearea
END


TO PASTEINCIRCLE :imagewidth :radius

  REPEAT 18 [
    RIGHT   20
    FORWARD :radius

    ; move such that the paste will be centered
    LOCALMAKE "x XCOR
    LOCALMAKE "y YCOR
    SETXY :x - :imagewidth :y - :imagewidth
    BITPASTE 
    SETXY :x :y

    BACK    :radius
  ]
END


; smoke test for BITCUT, BITCOPY, and BITPASTE
TO BITCOPYTEST

  CLEARSCREEN
  SETBITMODE 1
  PENDOWN

  ; draw a red pattern
  SETPENSIZE [2 2]
  REPEAT 72 [
    REPEAT 4 [FORWARD 100 RIGHT 90] 
    SETPENCOLOR (LIST REPCOUNT*3 0 0)
    RIGHT 5
  ]

  ; cut out part of the pattern to the clipboard
  PENUP
  SETXY -50 -50
  SETBITINDEX 0
  BITCUT 100 100

  ; draw a green pattern
  CLEARSCREEN
  PENDOWN
  SETPENSIZE [1 1]
  REPEAT 36 [
    REPEAT 4 [FORWARD 100 RIGHT 90] 
    SETPENCOLOR (LIST 0 REPCOUNT*6 0)
    RIGHT 10
  ]

  ; cut out the green pattern to index 1
  PENUP
  SETXY -20 -20
  SETBITINDEX 1
  BITCUT 40 40


  ; erase everything
  CLEARSCREEN

  ; paste the red pattern in a circle
  SETBITINDEX 0
  PASTEINCIRCLE 50 150

  ; paste the green pattern in a smaller circle
  SETBITINDEX 1
  PASTEINCIRCLE 20 50

  ; copy and paste some of the image
  SETBITINDEX 2
  BITCOPY 200 200
  RIGHT    90
  FORWARD  200
  BITPASTE

  CHECKSCREEN "bitpaste-pattern

  PENDOWN
  
END

TO BITCUTTEST.BADINPUT
    ; Set BITINDEX to something that isn't the clipboard.
    TRACEINSTRUCTION [ SETBITINDEX 1  ]

    RUNNOTENOUGHINPUTSTEST [ (BITCUT 100)              ]
    RUNTOOMANYINPUTSTEST   [ (BITCUT 100 100 "toomany) ]

    ; Try to cut a larger image than we have memory to store.
    BITMAPTEST.RUNCUTFAILEDTEST [ BITCUT 1000000 1000000 ]

    RUNDOESNTLIKEINPUTTEST [ BITCUT -1   100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 1.5  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT "1a  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT []   100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT [1]  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT {1}  100  ]

    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  -1   ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  1.5  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  "1a  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  []   ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  [1]  ]
    RUNDOESNTLIKEINPUTTEST [ BITCUT 100  {1}  ]
END

TO BITCOPYTEST.BADINPUT
    ; Set BITINDEX to something that isn't the clipboard.
    TRACEINSTRUCTION [ SETBITINDEX 1  ]

    RUNNOTENOUGHINPUTSTEST [ (BITCOPY 100)              ]
    RUNTOOMANYINPUTSTEST   [ (BITCOPY 100 100 "toomany) ]

    ; Try to copy a larger image than we have memory to store.
    BITMAPTEST.RUNCUTFAILEDTEST [ BITCOPY 1000000 1000000 ]

    RUNDOESNTLIKEINPUTTEST [ BITCOPY -1   100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 1.5  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY "1a  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY []   100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY [1]  100  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY {1}  100  ]

    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  -1   ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  1.5  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  "1a  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  []   ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  [1]  ]
    RUNDOESNTLIKEINPUTTEST [ BITCOPY 100  {1}  ]
END

TO BITPASTETEST.BADINPUT
    ; Paste from an index that has no bitmap.
    TRACEINSTRUCTION [ SETBITINDEX 41 ]
    BITMAPTEST.RUNNOTHINGTOPASTETEST [ BITPASTE ]

    ; Set the BITINDEX to something which has a bitmap.
    TRACEINSTRUCTION [ SETBITINDEX 1   ]
    TRACEINSTRUCTION [ BITCOPY 100 100 ]

    RUNTOOMANYINPUTSTEST [ (BITPASTE "toomany) ]
END


TO BITPASTETOINDEXTEST.SMOKETEST

    LOCALMAKE "savedScreenColor SCREENCOLOR

    LOCALMAKE "sprite     1
    LOCALMAKE "background 2
    LOCALMAKE "backbuffer 3

    ; create a recognizable shape to copy & paste
    TRACEINSTRUCTION [ SETSCREENCOLOR 3 ]
    TRACEINSTRUCTION [ SETPENCOLOR    4 ]
    TRACEINSTRUCTION [ CLEARSCREEN      ]
    TRACEINSTRUCTION [ REPEAT 3 [ FORWARD 20  RIGHT 120 ] ]

    ; initialize bitindex 1 to the sprite
    TRACEINSTRUCTION [ SETBITINDEX :sprite ]
    TRACEINSTRUCTION [ BITCUT 25 25 ]

    ; initialize bitindex 2 to the background
    TRACEINSTRUCTION [ SETBITINDEX :background  ]
    TRACEINSTRUCTION [ SETPENCOLOR 1  ]
    TRACEINSTRUCTION [ REPEAT 20 [ CIRCLE2 100 RIGHT 18 ] ]
    TRACEINSTRUCTION [ BITCUT 100 100 ]

    ; initialize bitindex 3 to the drawing surface
    TRACEINSTRUCTION [ SETBITINDEX :backbuffer ]
    TRACEINSTRUCTION [ BITCUT 100 100 ]

    ; create a simple animation
    TRACEINSTRUCTION [ SETSCREENCOLOR 5 ]
    TRACEINSTRUCTION [ HIDETURTLE       ]

    REPEAT 12 [ 

       ; clear the back-buffer to the background image
       TRACEINSTRUCTION [ SETBITINDEX :background ]
       TRACEINSTRUCTION [ BITPASTETOINDEX :backbuffer 0 0 ]

       ; copy the sprites into position
       TRACEINSTRUCTION [ SETBITINDEX :sprite ]
       TRACEINSTRUCTION [ BITPASTETOINDEX :backbuffer          50            (10 - REPCOUNT) * 10 ]
       TRACEINSTRUCTION [ BITPASTETOINDEX :backbuffer (REPCOUNT - 2) * 10            0            ]

       ; copy the back buffer to the screen
       TRACEINSTRUCTION [ SETBITINDEX :backbuffer ]
       TRACEINSTRUCTION [ BITPASTE ]
       TRACEINSTRUCTION [ WAIT 10  ]
    ]

    TRACEINSTRUCTION [ SHOWTURTLE ]

    SETSCREENCOLOR :savedScreenColor
END

TO BITPASTETOINDEXTEST.BADINPUT

    ; initialize bitindex 1 and fill it with a valid bitmap
    TRACEINSTRUCTION [ SETBITINDEX 1  ]
    TRACEINSTRUCTION [ BITCUT 100 100 ]

    RUNNOTENOUGHINPUTSTEST [ (BITPASTETOINDEX 1 0)            ]
    RUNTOOMANYINPUTSTEST   [ (BITPASTETOINDEX 1 0 0 "toomany) ]

    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX -1   0   0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX 1.5  0   0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX [1]  0   0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX {1}  0   0 ]

    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1  1.5  0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1  [0]  0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1  {0}  0 ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1  "one 0 ]

    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1   0  1.5  ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1   0  [0]  ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1   0  {0}  ]
    RUNDOESNTLIKEINPUTTEST [ BITPASTETOINDEX  1   0  "one ]

    ; Target index is out of range (higher than max ever set)
    BITMAPTEST.RUNINDEXOUTOFRANGETEST [ BITPASTETOINDEX 10000 0 0 ]

    ; Copy from a bitmap that is not initialized.
    TRACEINSTRUCTION                 [ SETBITINDEX 41  ]
    BITMAPTEST.RUNNOTHINGTOPASTETEST [ BITPASTETOINDEX 1 0 0 ]

    ; Copy a valid bitmap to an index that is not initialized.
    TRACEINSTRUCTION                 [ SETBITINDEX 1   ]
    BITMAPTEST.RUNNOTARGETBITMAPTEST [ BITPASTETOINDEX 41 0 0 ]

END

TO BITSAVE.TESTHELPER :bitdepth :activearea :pictureinstructions
    LOCAL [savedActiveArea savedPenColor filename expectedDimensions]
    MAKE "savedActiveArea ACTIVEAREA
    MAKE "savedPenColor   PENCOLOR
    MAKE "filename (
        WORD "bitsave_
            ITEM 1 :activeArea
            "_
            ITEM 2 :activeArea
            "_
            ITEM 3 :activeArea
            "_
            ITEM 4 :activeArea
            "_
            :bitdepth
            "bpp.bmp)

    ; Draw a distinctive picture.
    CLEARSCREEN
    HIDETURTLE
    RUN :pictureinstructions
    SHOWTURTLE

    ; Save the picture.
    ERASEFILE :filename
    SETACTIVEAREA :activearea
    (BITSAVE :filename :bitdepth)

    ; Check that the bitmap was saved correctly.
    IF FILEEXISTS :filename [
       MAKE "expectedDimensions (LIST 
           (ITEM 3 :activearea) - (ITEM 1 :activearea)
           (ITEM 4 :activearea) - (ITEM 2 :activearea))

       SIMPLEREPORTTEST [ BITLOADSIZE :filename ] :expectedDimensions
    ]
    CHECKFILEAGAINSTBASELINE :filename (word "testimage- :filename)

    ; cleanup
    SETACTIVEAREA :savedActiveArea
    SETPENCOLOR   :savedPenColor
END

TO BITSAVE.1BPP
    IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows

    ; Use a width that isn't DWORD-aligned to test that
    ; BITSAVE adds the necessary padding.
    LOCALMAKE "activearea [ -100 -100 103 203 ]

    ; Draw the picture in blue to make it obvious that it gets
    ; saved in monochrome.
    LOCALMAKE "pictureinstructions [
       SETPENCOLOR 1
       REPEAT 500 [ FORWARD REPCOUNT RIGHT 90 ]
    ]

    ; Run the test
    BITSAVE.TESTHELPER 1 :activearea :pictureinstructions
END

TO BITSAVE.4BPP
    IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows

    ; Use a width that isn't DWORD-aligned to test that
    ; BITSAVE adds the necessary padding.
    LOCALMAKE "activearea [ -50 -50 103 203 ]

    ; Draw the picture with 16 colors to make it obvious
    ; that it gets saved in four colors.
    LOCALMAKE "pictureinstructions [
       REPEAT 500 [ FORWARD REPCOUNT RIGHT 90 SETPENCOLOR REPCOUNT ]
    ]

    BITSAVE.TESTHELPER 4 :activearea :pictureinstructions
END

TO BITSAVE.HIGHBPP :bitdepth
    ; Use a width that isn't DWORD-aligned to test that
    ; BITSAVE adds the necessary padding.
    LOCALMAKE "activearea [ -200 -200 203 203 ]

    ; Draw a picture with 24-bit colors to make it obvious
    ; if it gets saved with a lower bit-depth.
    LOCALMAKE "counter 0
    LOCALMAKE "pictureinstructions [

        PENUP
        REPEAT 512 [
            SETXY REPCOUNT-210 -210
            REPEAT 512 [
                SETPIXEL (LIST
                    BITAND 255 (SUM 128 ASHIFT :counter -16)
                    BITAND 255 ASHIFT :counter -8
                    BITAND 255 :counter)
                FORWARD 1
                MAKE "counter :counter + 1
            ]
        ]
        PENDOWN
    ]

    BITSAVE.TESTHELPER :bitdepth :activearea :pictureinstructions
END

TO BITSAVE.8BPP
    IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows
    BITSAVE.HIGHBPP 8
END

TO BITSAVE.8BPP.FULLSCREEN
    IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows

    ; Use an ACTIVEAREA that exactly matches the screen extents.
    ; There's an optimization for this at low bit depths.
    LOCAL [activearea pictureinstructions]
    MAKE "activearea [ -500 -500 500 500 ]

    ; Draw a picture with 24-bit colors to make it obvious
    ; if when it gets saved with a lower bit-depth.
    MAKE "pictureinstructions [
       PENUP
       SETXY -500 500
       SETHEADING 90 ; face right
       PENDOWN

       ; draw two lines, back and forth
       REPEAT 1000 [
           ; A new color
           SETPENCOLOR (LIST
               BITAND 255 SUM 128 REPCOUNT
               BITAND 255 SUM 64  REPCOUNT
               BITAND 255 REPCOUNT
           )

           ; Draw a horizontal line (wrapping)
           FORWARD 1000

           ; Down one line
           RIGHT 90
           FORWARD 1
           LEFT 90
       ]
    ]

    BITSAVE.TESTHELPER 8 :activearea :pictureinstructions
END

TO BITSAVE.16BPP
    BITSAVE.HIGHBPP 16
END

TO BITSAVE.24BPP
    BITSAVE.HIGHBPP 24
END

TO BITSAVE.32BPP
    BITSAVE.HIGHBPP 32
END

TO BITSAVE.WITHACTIVEAREA
    ; This is a regression test for bug #301.
    LOCALMAKE "savedActiveArea ACTIVEAREA
    LOCALMAKE "savedPenColor   PENCOLOR

    CLEARSCREEN
    REPEAT 500 [ FORWARD REPCOUNT RIGHT 91 SETPENCOLOR REPCOUNT ]
    
    SETACTIVEAREA [ 0 0 200 200 ]
    BITSAVE "bitsave-withactivearea.bmp

    CLEARSCREEN
    BITLOAD  "bitsave-withactivearea.bmp

    ; did the image get restored correctly?
    CHECKSCREEN "bitsave-200x200

    ; cleanup
    SETACTIVEAREA :savedActiveArea
    SETPENCOLOR   :savedPenColor
    ERASEFILE     "bitsave-withactivearea.bmp
END

TO BITSAVE.LARGEBITMAP
    ; This is a regression test for bug #425
    IF NOT ISWINDOWS [ STOP ] ; BITSAVE for low bit depths currently only runs on Windows

    LOCAL [width height]
    MAKE "width  6614
    MAKE "height 4677

    ; Run a program to save a large bitmap in a separate FMSLogo instance.
    ; This is done in a separate instance because saving it requires
    ; a custom width and height and these cannot be changed after startup.
    WRITEBINARYDATA "bitsave-largebitmap.lgo (WORD
        "|TO BITSAVE.LARGEBITMAP\n|
        "|  ; Set the active area to whatever was passed in on the command line.\n|
        "|  MAKE "width  (ITEM 3 MACHINE)\n|
        "|  MAKE "height (ITEM 4 MACHINE)\n|
        "|  SETACTIVEAREA (LIST\n|
        "|    -(INT :width  / 2)\n|
        "|    -(INT :height / 2)\n|
        "|     (INT :width  / 2)\n|
        "|     (INT :height / 2))\n|
        "|\n|
        "|  ; Draw something on the screen.\n|
        "|  HIDETURTLE\n|
        "|  REPEAT 5000 [ SETPENCOLOR REPCOUNT FORWARD REPCOUNT RIGHT 90 ]\n|
        "|\n|
        "|  ; Save the picture\n|
        "|  (BITSAVE "bitsave-largebitmap-24bpp.bmp 24)\n|
        "|  (BITSAVE "bitsave-largebitmap-1bpp.bmp  1)\n|
        "|\n|
        "|  ; Quit\n|
        "|  BYE\n|
        "|END\n|
        "|\n|
        "|MAKE "startup [BITSAVE.LARGEBITMAP]\n|
    )

    ; Spawn an instance of FMSLogo with a large with and height that will
    ; create a bitmap.
    SIMPLEREPORTTEST [
        (SHELL (LIST "fmslogo "-W :width "-H :height "-L "bitsave-largebitmap.lgo) LOCALETRUE)
    ] LOCALETRUE

    ; Confirm that both bitmaps were saved as expected.
    CHECKFILEAGAINSTBASELINE "bitsave-largebitmap-1bpp.bmp  "testimage-bitsave-largebitmap-1bpp.bmp
    CHECKFILEAGAINSTBASELINE "bitsave-largebitmap-24bpp.bmp "testimage-bitsave-largebitmap-24bpp.bmp

    ; Cleanup
    ERASEFILE "bitsave-largebitmap.lgo
    ERASEFILE "bitsave-largebitmap-1bbp.bmp
    ERASEFILE "bitsave-largebitmap-24bbp.bmp
END


TO BITSAVE.FILEEXISTS
    ; Calls BITSAVE when the file already exists to test
    ; that the existing file is over-written.

    LOCALMAKE "savedActiveArea ACTIVEAREA
    LOCALMAKE "savedPenColor   PENCOLOR
    LOCALMAKE "filename        "bitsavetest-existingfile.bmp

    ; Write some data to the file.
    TRACEINSTRUCTION [ WRITEBINARYDATA :filename "|Some existing data| ]

    ; Draw a distinctive picture.
    CLEARSCREEN
    HIDETURTLE
    REPEAT 100 [ FORWARD REPCOUNT LEFT 90 SETPENCOLOR REPCOUNT ]
    SHOWTURTLE

    ; Save the picture, ovewriting the file.
    SETACTIVEAREA [-50 -50 50 50]
    BITSAVE :filename

    ; Check that the bitmap was saved correctly.
    CHECKFILEAGAINSTBASELINE :filename (WORD "testimage- :filename)

    ; cleanup
    SETACTIVEAREA :savedActiveArea
    SETPENCOLOR   :savedPenColor
    ERASEFILE     :filename
END

TO SETBITINDEX.SMOKETEST
    TRACEINSTRUCTION [ SETBITINDEX 4 ] 
    SIMPLEREPORTTEST [ BITINDEX  ] 4
END

TO SETBITINDEX.BADINPUT

    ; initialize bitindex 4
    TRACEINSTRUCTION [ SETBITINDEX 4  ]


    RUNNOTENOUGHINPUTSTEST [ (SETBITINDEX)            ]
    RUNTOOMANYINPUTSTEST   [ (SETBITINDEX 1 "toomany) ]

    RUNTOOMANYINPUTSTEST   [ (BITINDEX "toomany) ]

    RUNDOESNTLIKEINPUTTEST [ SETBITINDEX -1   ]
    RUNDOESNTLIKEINPUTTEST [ SETBITINDEX 1.5  ]
    RUNDOESNTLIKEINPUTTEST [ SETBITINDEX [1]  ]
    RUNDOESNTLIKEINPUTTEST [ SETBITINDEX {1}  ]
    RUNDOESNTLIKEINPUTTEST [ SETBITINDEX "one ]

    RUNOUTOFMEMORYTEST [SETBITINDEX 500000000  ] ; allocation failure
    RUNOUTOFMEMORYTEST [SETBITINDEX 2000000000 ] ; integer overflow

    ; make sure that the selected bitmap didn't change
    SIMPLEREPORTTEST [ BITINDEX  ] 4
END

TO BITLOAD.POSITION
   ; Tests that small images are loaded at the turtle's position
   ; and ignore the turtle's orientation while large images are
   ; always drawn in the upper left corner.

   IF (OR NOT EQUAL? ITEM 3 MACHINE 1000
          NOT EQUAL? ITEM 4 MACHINE 1000) [
      REPORTTESTBUG "|This test requires a 1000x1000 drawing surface|
      STOP
   ]

   ; Put the turtle at 0,0 facing upward
   TRACEINSTRUCTION [ CLEARSCREEN ]
   TRACEINSTRUCTION [ WRAP ]

   ; Move the turtle (and change its heading) so that
   ; the bitmap is partially offscreen
   TRACEINSTRUCTION [ PENUP             ]
   TRACEINSTRUCTION [ SETPOS  [100 100] ]
   TRACEINSTRUCTION [ RIGHT   90        ]
   
   ; Load a bitmap that is half the width and height of
   ; the drawing surface...just small enough for BITLOAD to
   ; place it at the turtle's position.  Because we moved
   ; the turtle, the image should be truncated.  And even
   ; in WRAP mode, the bitmap does not wrap.  Also, even
   ; with PENUP, the bitmap is drawn.
   TRACEINSTRUCTION [ BITLOAD "rle4-encoded-500x500.bmp ]

   ; Confirm that the image was loaded correctly.
   CHECKSCREEN "bitload-500x500

   ; Now load a bitmap whose width is barely larger than half
   ; of the width of the drawing surface.  This should be drawn
   ; in the upper-left corner, regardless of the turtle's location.
   TRACEINSTRUCTION [ BITLOAD "rle4-encoded-501x500.bmp ]
   CHECKSCREEN "bitload-501x500

   ; Load a bitmap whose height is barely larger than half
   ; of the height of the drawing surface.  This should be drawn
   ; in the upper-left corner, regardless of the turtle's location.
   TRACEINSTRUCTION [ CLEAN ]
   TRACEINSTRUCTION [ BITLOAD "rle4-encoded-500x501.bmp ]
   CHECKSCREEN "bitload-500x501

   ; Now enter PERSPECTIVE mode and draw the bitmap while the
   ; turtle is barely onscreen.  The bitmap is drawn flat.
   TRACEINSTRUCTION [ PENDOWN     ]
   TRACEINSTRUCTION [ CLEARSCREEN ]
   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETXYZ 350 350 250 ]
   TRACEINSTRUCTION [ UPPITCH 90         ]
   TRACEINSTRUCTION [ BITLOAD "rle4-encoded-500x500.bmp ]
   CHECKSCREEN "bitload-perspective-onscreen


   ; Now enter PERSPECTIVE mode and draw the bitmap while the
   ; turtle is offscreen.
   TRACEINSTRUCTION [ CLEARSCREEN ]
   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETXYZ 400 400 100 ]
   TRACEINSTRUCTION [ BITLOAD "rle4-encoded-500x500.bmp ]
   CHECKSCREEN "bitload-perspective-offscreen
  
   ; Restore the state
   TRACEINSTRUCTION [ WRAP        ]
   TRACEINSTRUCTION [ CLEARSCREEN ]
END

TO BITLOADTEST.HELPER :type :filename :width :height [:extension ".bmp]
    ; Determine the location of the test image.
    LOCAL "filepath
    MAKE  "filepath (WORD "bmptestsuite-0.9/ :type "/ :filename :extension)

    ; First, test that BITLOADSIZE correctly determines the size of the bitmap
    SIMPLEREPORTTEST (LIST "BITLOADSIZE QUOTED :filepath)  (LIST :width :height)

    ; Move the turtle so that the image will be roughly centered.
    CLEARSCREEN
    PENUP
    SETXY -:width / 2  -:height / 2
    PENDOWN

    ; Load the image
    TRACEINSTRUCTION (LIST "BITLOAD QUOTED :filepath)

    ; Confirm that the image was loaded correctly.
    CHECKSCREEN (WORD :type "- :filename)
END

