   BITLOADTEST.HELPER "valid "24bpp-1x1                   1   1
   BITLOADTEST.HELPER "valid "24bpp-320x240               320 240
   BITLOADTEST.HELPER "valid "24bpp-321x240               321 240
   BITLOADTEST.HELPER "valid "24bpp-322x240               322 240
