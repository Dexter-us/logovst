TO BITLOAD.BADINPUT
   RUNNOTENOUGHINPUTSTEST [(BITLOAD)]
   RUNTOOMANYINPUTSTEST   [(BITLOAD "file.bmp "toomany)]

   ; bad input
   RUNBITMAPOPENERRORTEST [ BITLOAD "doesnotexist.bmp ]
   RUNDOESNTLIKEINPUTTEST [ BITLOAD {a b c}           ]
   RUNDOESNTLIKEINPUTTEST [ BITLOAD [a b c]           ]

   ; try to open something that isn't a BMP as a BMP
   RUNBITMAPINVALIDERRORTEST [ BITLOAD "bitmap.lgo   ]

   ; try to open a directory as a BMP
   RUNBITMAPOPENERRORTEST [ BITLOAD "bmptestsuite-0.9/corrupt/directory.bmp ]
END

TO BITSAVE.BADINPUT

   ; bad filename input (must be a word)
   RUNDOESNTLIKEINPUTTEST [ BITSAVE {1 2 3}       ]
   RUNDOESNTLIKEINPUTTEST [ BITSAVE [1 2 3]       ]
   RUNBITMAPOPENERRORTEST [ BITSAVE "||           ]
   RUNBITMAPOPENERRORTEST [ BITSAVE "bad>file.bmp ]

   ; max color depth (must be a member of {1,2,4,24,32})
   RUNDOESNTLIKEINPUTTEST [ (BITSAVE "file.bmp 3        ) ]
   RUNDOESNTLIKEINPUTTEST [ (BITSAVE "file.bmp "nonint  ) ]
   RUNDOESNTLIKEINPUTTEST [ (BITSAVE "file.bmp [1 2 3]  ) ]
   RUNDOESNTLIKEINPUTTEST [ (BITSAVE "file.bmp {1 2 3}  ) ]
   RUNDOESNTLIKEINPUTTEST [ (BITSAVE "file.bmp -1       ) ]

   ; make sure that none of the above created the file
   SIMPLEREPORTTEST [FILEEXISTS "file.bmp] "false

   ; cleanup, just in case
   TRACEINSTRUCTION [ ERASEFILE "file.bmp ]

   ; try to save a bmp over a directory
   TRACEINSTRUCTION       [ MKDIR   "bmptest.bmp POPDIR ]
   RUNBITMAPOPENERRORTEST [ (BITSAVE "bmptest.bmp 24)   ]
   RUNBITMAPOPENERRORTEST [ (BITSAVE "bmptest.bmp 1)    ] ; different code path
   TRACEINSTRUCTION       [ RMDIR   "bmptest.bmp        ]

END

TO BITMAPTEST.COPYTOCLIPBOARD :clipboardFormat :binaryContent
   ; Validate input
   REPEAT COUNT :binaryContent [
      IF GREATER? ASCII ITEM REPCOUNT :binaryContent 255 [
         REPORTTESTBUG (WORD
            "|binaryContent has non-binary byte at index |
            REPCOUNT
            "|: |
            ASCII ITEM REPCOUNT :binaryContent
         )
         STOP
      ]
   ]

   ; FMSLogo internally stores words as UTF16LE.
   ; To convert the input word, which contains a single byte per UTF16LE
   ; character, we copy it to a new buffer, taking only the lowest 256 bits
   ; of each character.
   LOCAL [buffer bufferSize]
   MAKE "bufferSize COUNT    :binaryContent
   MAKE "buffer     AS_PVOID :binaryContent

   ; Use win32 calls to copy :buffer to the clipboard.
   LOCALMAKE "hMem GLOBALALLOC :buffer :bufferSize

   SETCLIPBOARDDATA :clipboardFormat :hMem

   GLOBALFREE :hMem

END

; FMSLogo internally stores words as UTF16LE.
; To convert the input word, which contains a single byte per UTF16LE
; character, we copy it to a new word, taking only the lowest 256 bits
; of each character, combining pairs of bytes into UTF16LE characters.
TO AS_PVOID :charArray
   LOCAL [buffer bufferSize lowByte highByte]

   MAKE "buffer "||
   REPEAT INT QUOTIENT COUNT :charArray 2 [
      MAKE "lowByte  ASCII ITEM REPCOUNT * 2 - 1 :charArray
      MAKE "highByte ASCII ITEM REPCOUNT * 2     :charArray
      MAKE "buffer WORD :buffer CHAR BITOR LSHIFT :highByte 8 :lowByte
   ]
   IF NOTEQUAL? 0 MODULO COUNT :charArray 2 [
      ; Copy the last byte if :binaryContent has an odd number of characters
      MAKE "lowByte ASCII ITEM :bufferSize :charArray
      MAKE "buffer WORD :buffer CHAR :lowByte
   ]
   OUTPUT :buffer
END

TO AS_BYTE :byte
  OUTPUT CHAR BITAND 255 :byte
END

; Converts a number to a 32-bit little endian word.
TO AS_DWORD :dword
  ; lsb comes first in little endian
  OUTPUT (WORD
    AS_BYTE LSHIFT :dword 0
    AS_BYTE LSHIFT :dword -8
    AS_BYTE LSHIFT :dword -16
    AS_BYTE LSHIFT :dword -24)
END

; Converts a number to a 16-bit little endian word.
TO AS_WORD :word
  OUTPUT (WORD
    AS_BYTE LSHIFT :word 0
    AS_BYTE LSHIFT :word -8)
END

TO AS_RGBQUAD :r :g :b
  OUTPUT (WORD AS_BYTE :r AS_BYTE :g AS_BYTE :b AS_BYTE 0)
END


TO BITSIZE.CLIPBOARDTEST
    IF NOT ISWINDOWS [ STOP ] ; This test only runs on Windows

    ; Copy a 1x2 DIB to the clipboard
    LOCALMAKE "CF_DIB 8
    BITMAPTEST.COPYTOCLIPBOARD :CF_DIB (WORD
       AS_DWORD 40 ; biSize
       AS_DWORD 2  ; biWidth
       AS_DWORD 1  ; biHeight
       AS_WORD  1  ; biPlanes
       AS_WORD  32 ; biBitCount
       AS_DWORD 0  ; biCompression (BI_RGB)
       AS_DWORD 0  ; biSizeImage
       AS_DWORD 0  ; biXPelsPerMeter
       AS_DWORD 0  ; biYPelsPerMeter
       AS_DWORD 0  ; biClrUsed
       AS_DWORD 0  ; biClrImportant

       AS_RGBQUAD 0   0 255
       AS_RGBQUAD 255 0   0
    )

    TRACEINSTRUCTION [ SETBITINDEX 0 ]
    SIMPLEREPORTTEST [ BITSIZE ] [ 2 1 ]

    ; Copy an HBITMAP to the clipboard
    ; Native code to copy data to the clipboard.
    DLLLOAD "gdi32.dll

    ; hbitmap = CreateBitmap(width=1, height=4, planes=1, bitcount=32, bits);
    LOCALMAKE "bits   AS_PVOID (WORD
        CHAR 255  CHAR   0  CHAR   0  CHAR    0   ; BGRA
        CHAR 0    CHAR 255  CHAR   0  CHAR    0   ; BGRA
        CHAR 0    CHAR   0  CHAR 255  CHAR    0   ; BGRA
        CHAR 0    CHAR   0  CHAR   0  CHAR  255   ; BGRA
    )
    LOCALMAKE "hbitmap DLLCALL (LIST "L "CreateBitmap "U :bits "L 32 "L 1 "L 4 "L 1)

    LOCALMAKE "CF_BITMAP 2
    SETCLIPBOARDDATA :CF_BITMAP :hbitmap

    ; DeleteObject(hbitmap)
    DLLCALL (LIST "V "DeleteObject "L :hbitmap)
    (DLLFREE "gdi32.dll)

    SIMPLEREPORTTEST [ BITSIZE ] [ 1 4 ]
END

TO BITSIZE.SMOKETEST
    TRACEINSTRUCTION [ SETBITINDEX 1 ]

    TRACEINSTRUCTION [ BITCOPY 3 2   ]
    SIMPLEREPORTTEST [ BITSIZE       ] [ 3 2 ]

    TRACEINSTRUCTION [ BITCOPY 9  5  ]
    SIMPLEREPORTTEST [ BITSIZE       ] [ 9 5 ]

    TRACEINSTRUCTION [ BITCOPY 10000 10000 ]
    SIMPLEREPORTTEST [ BITSIZE       ] [ 10000 10000 ]
END


TO BITSIZE.BADINPUT

    RUNTOOMANYINPUTSTEST   [ (BITSIZE "toomany) ]

    ; Determine the size of a bitmap that doesn't exist.
    TRACEINSTRUCTION [ SETBITINDEX 41 ]
    SIMPLEREPORTTEST [ BITSIZE ] [ 0 0 ]

    ; Determine the size of the clipboard bitmap when it has text
    TRACEINSTRUCTION [ OPENWRITE "clipboard ]
    TRACEINSTRUCTION [ SETWRITE "clipboard ]
    TRACEINSTRUCTION [ PRINT "text ]
    TRACEINSTRUCTION [ SETWRITE [] ]
    TRACEINSTRUCTION [ CLOSE "clipboard ]

    TRACEINSTRUCTION [ SETBITINDEX 0 ]
    SIMPLEREPORTTEST [ BITSIZE ] [ 0 0 ]

END

TO BITMAPTEST
  BITLOADSIZETEST 100 100 1
  BITLOADSIZETEST 100 101 1
  BITLOADSIZETEST 101 100 1

  BITLOAD.BADINPUT
  BITLOAD.POSITION
  BITLOAD.MALFORMED
  BITLOAD.1BPP
  BITLOAD.4BPP
  BITLOAD.8BPP
  BITLOAD.24BPP
  BITLOAD.32BPP
  BITLOAD.MISC
  BITLOAD.JPEG

  BITSAVE.BADINPUT

  BITCOPYTEST

  BITCUTTEST.BADINPUT
  BITCOPYTEST.BADINPUT
  BITPASTETEST.BADINPUT

  BITPASTETOINDEXTEST.BADINPUT
  BITPASTETOINDEXTEST.SMOKETEST

  SETBITINDEX.SMOKETEST
  SETBITINDEX.BADINPUT

  BITSAVE.1BPP
  BITSAVE.4BPP
  BITSAVE.8BPP
  BITSAVE.8BPP.FULLSCREEN
  BITSAVE.16BPP
  BITSAVE.24BPP
  BITSAVE.32BPP
  BITSAVE.WITHACTIVEAREA
  BITSAVE.LARGEBITMAP
  BITSAVE.FILEEXISTS

  BITSIZE.SMOKETEST
  IF ISWINDOWS [ ; works around a "DLLCALL not defined" bug on GNU/Linux
    BITSIZE.CLIPBOARDTEST
  ]
  BITSIZE.BADINPUT
END
