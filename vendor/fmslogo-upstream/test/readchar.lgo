LOAD "testlib.lgo

TO READCHARTEST.READDATA :filename :expecteddata
   LOCAL [previousreader datum]

   MAKE "previousreader READER

   SETREAD   :filename

   WHILE [ NOT EMPTY? :expecteddata ] [
      MAKE "datum POP "expecteddata
      SIMPLEREPORTTEST [READCHAR] :datum
   ]
   SIMPLEREPORTTEST [READCHAR] [] ; end of file

   SETREAD   :previousreader
END

TO READCHARTEST.SMOKETEST
   LOCAL [filename textdata]

   MAKE "filename "readchartest.smoketest.txt

   ; Write characters from 0-500 (past the Latin-1 page)
   MAKE "textdata   APPLY "WORD MAP "CHAR ISEQ 0 500

   ; Write out the data as text.
   OPENWRITE :filename
   SETWRITE  :filename
   TYPE      :textdata
   SETWRITE  []
   CLOSE     :filename

   ; Test calling READCHAR on a file that is opened in text mode.
   OPENREAD               :filename
   READCHARTEST.READDATA  :filename :textdata
   CLOSE                  :filename

   ERASEFILE :filename
END

TO READCHARTEST.BINARY
   LOCAL [filename binarydata textdata]

   MAKE "filename "readchartest.binary.txt
   MAKE "binarydata ISEQ 0 255
   MAKE "textdata   APPLY "WORD MAP "CHAR :binarydata

   WRITEBINARYDATA :filename :textdata

   ; Test calling READCHAR on a file that is opened in binary mode.
   ; Note that in binary mode, the data is expected to be numbers.
   (OPENREAD              :filename LOCALETRUE)
   READCHARTEST.READDATA  :filename :binarydata
   CLOSE                  :filename

   ERASEFILE :filename
END

TO READCHARTEST.BADINPUT

   RUNTOOMANYINPUTSTEST [(READCHAR "toomany)]
   RUNTOOMANYINPUTSTEST [(RC       "toomany)]

END

TO READCHARTEST

   READCHARTEST.SMOKETEST
   READCHARTEST.BINARY
   READCHARTEST.BADINPUT

END
