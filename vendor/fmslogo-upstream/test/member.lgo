LOAD "testlib.lgo

TO MEMBERTEST.SMOKETEST
  SIMPLEREPORTTEST [ MEMBER "abc "abc    ] "||
  SIMPLEREPORTTEST [ MEMBER "b   "abc    ] "bc
  SIMPLEREPORTTEST [ MEMBER 3    [1 2 3] ] [3]
END


TO MEMBERTEST.VARIATIONS
  SIMPLEREPORTTEST [ MEMBER 12 123   ] "||
  SIMPLEREPORTTEST [ MEMBER 2  123   ] 23

  ; No explicit ignore case
  LOCAL "CASEIGNOREDP
  SIMPLEREPORTTEST [ MEMBER "b "abc     ] "bc
  SIMPLEREPORTTEST [ MEMBER "x "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "B "abc     ] "bc
  SIMPLEREPORTTEST [ MEMBER "C "ABC     ] "C
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "c
  SIMPLEREPORTTEST [ MEMBER "A "abcABC  ] "abcABC
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "c
  SIMPLEREPORTTEST [ MEMBER "ab "abAB   ] "||

  SIMPLEREPORTTEST [ MEMBER "a  [a]     ] [a]
  SIMPLEREPORTTEST [ MEMBER "a  [a b c] ] [a b c]
  SIMPLEREPORTTEST [ MEMBER "B  [a b c] ] [b c]
  SIMPLEREPORTTEST [ MEMBER "c  [a b c] ] [c]
  SIMPLEREPORTTEST [ MEMBER "x  [a b c] ] []
  SIMPLEREPORTTEST [ MEMBER "ab [ab bc abc AB BC] ] [ab bc abc AB BC]
  SIMPLEREPORTTEST [ MEMBER "AB [ab bc abc AB BC] ] [ab bc abc AB BC]
  SIMPLEREPORTTEST [ MEMBER "aB [ab bc abc AB BC] ] [ab bc abc AB BC]

  ; Ignore case explicitly (same result as above)
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "TRUE ]
  SIMPLEREPORTTEST [ MEMBER "b "abc     ] "bc
  SIMPLEREPORTTEST [ MEMBER "x "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "B "abc     ] "bc
  SIMPLEREPORTTEST [ MEMBER "C "ABC     ] "C
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "c
  SIMPLEREPORTTEST [ MEMBER "A "abcABC  ] "abcABC
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "c
  SIMPLEREPORTTEST [ MEMBER "ab "abAB   ] "||

  SIMPLEREPORTTEST [ MEMBER "a  [a]     ] [a]
  SIMPLEREPORTTEST [ MEMBER "a  [a b c] ] [a b c]
  SIMPLEREPORTTEST [ MEMBER "B  [a b c] ] [b c]
  SIMPLEREPORTTEST [ MEMBER "c  [a b c] ] [c]
  SIMPLEREPORTTEST [ MEMBER "x  [a b c] ] []
  SIMPLEREPORTTEST [ MEMBER "ab [ab bc abc AB BC] ] [ab bc abc AB BC]
  SIMPLEREPORTTEST [ MEMBER "AB [ab bc abc AB BC] ] [ab bc abc AB BC]
  SIMPLEREPORTTEST [ MEMBER "aB [ab bc abc AB BC] ] [ab bc abc AB BC]

  ; Case-sensitive
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "FALSE ]
  SIMPLEREPORTTEST [ MEMBER "b "abc     ] "bc
  SIMPLEREPORTTEST [ MEMBER "x "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "B "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "C "ABC     ] "C
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "A "abcABC  ] "ABC
  SIMPLEREPORTTEST [ MEMBER "C "abc     ] "||
  SIMPLEREPORTTEST [ MEMBER "ab "abAB   ] "||

  SIMPLEREPORTTEST [ MEMBER "a  [a]     ] [a]
  SIMPLEREPORTTEST [ MEMBER "a  [a b c] ] [a b c]
  SIMPLEREPORTTEST [ MEMBER "B  [a b c] ] []
  SIMPLEREPORTTEST [ MEMBER "c  [a b c] ] [c]
  SIMPLEREPORTTEST [ MEMBER "x  [a b c] ] []
  SIMPLEREPORTTEST [ MEMBER "ab [ab bc abc AB BC] ] [ ab bc abc AB BC ]
  SIMPLEREPORTTEST [ MEMBER "AB [ab bc abc AB BC] ] [ AB BC ]
  SIMPLEREPORTTEST [ MEMBER "aB [ab bc abc AB BC] ] [ ]

END


TO MEMBERTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(MEMBER)]
  RUNNOTENOUGHINPUTSTEST [(MEMBER "a)]
  RUNTOOMANYINPUTSTEST   [(MEMBER 2 [1 2 3] "toomany)]

  RUNNONRECOVERABLEDOESNTLIKEINPUTTEST [MEMBER "a  {a}   ]
  RUNNONRECOVERABLEDOESNTLIKEINPUTTEST [MEMBER [a] {[a]} ]
END


TO MEMBERTEST
  MEMBERTEST.SMOKETEST
  MEMBERTEST.VARIATIONS
  MEMBERTEST.BADINPUT
END
