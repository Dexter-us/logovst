   RUNDOESNTLIKEINPUTTEST [ SETY []   ]
   RUNDOESNTLIKEINPUTTEST [ SETY [10] ]
   RUNDOESNTLIKEINPUTTEST [ SETY "1a  ]

   ; None of the bad input should have changed the position.
