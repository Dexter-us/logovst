TO SETZTEST.WRAP

   TRACEINSTRUCTION [ WRAP ]

   ; Set a known position.
   TRACEINSTRUCTION [ SETPOSXYZ [0 0 0] ]

   TRACEINSTRUCTION [ SETZ 0 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 0 0 0 ]

   ; SETZ does nothing outside of PERSPECTIVE mode.
   TRACEINSTRUCTION [ SETZ -5.5 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 0 0 0 ]

   ; Strings that are converted to numbers.
   TRACEINSTRUCTION [ SETZ "10 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 0 0 0 ]

END

TO SETZTEST.PERSPECTIVE
   ; Set the mode to PERSPECTIVE (SETZ only works in PERSPECTIVE mode)
   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETPOSXYZ [100 200 300] ]

   TRACEINSTRUCTION [ SETZ 2000 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 100 200 2000 ]

   TRACEINSTRUCTION [ SETZ -1e3 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 100 200 -1000 ]

   TRACEINSTRUCTION [ SETZ -5.5 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 100 200 -5.5 ]

   ; Strings are converted to numbers
   TRACEINSTRUCTION [ SETZ "5000 ]
   SIMPLEREPORTTEST [ POSXYZ ]  [ 100 200 5000 ]

   ; Back to the default mode.
   TRACEINSTRUCTION [ WRAP ]

END

TO SETZTEST.BADINPUT

   ; Set the position to known value so that we can be sure it doesn't change.
   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETPOSXYZ [ 51 52 53 ] ]

   ; bad number of inputs
   RUNNOTENOUGHINPUTSTEST [(SETZ)]
   RUNTOOMANYINPUTSTEST   [(SETZ 0 "toomany)]

   ; bad inputs
   RUNDOESNTLIKEINPUTTEST [ SETZ {10} ]
   RUNDOESNTLIKEINPUTTEST [ SETZ []   ]
   RUNDOESNTLIKEINPUTTEST [ SETZ [10] ]
   RUNDOESNTLIKEINPUTTEST [ SETZ "1a  ]

   ; None of the bad input should have changed the position.
   SIMPLEREPORTTEST [ POSXYZ ] [ 51 52 53 ]

   ; Back to the default mode.
   TRACEINSTRUCTION [ WRAP ]

END

TO SETZTEST.BADINPUT.RECOVERABLE

   ; Set the position to known value.
   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETPOSXYZ [ 1 2 3 ] ]

   ; Confirm that the recoverable errors are really recoverable.
   ; The first input is bad, as are all but the final replacement
   RUNRECOVERABLEERRORTEST [
      SETZ []  ; empty list is not legal
   ] (LIST
      [ 1 ]    ; can't be a list
      {10}     ; must be a number (not an array)
      "10x     ; must be a number (not a string)
      []       ; can't be the empty list (again)
      [ 2 ]    ; can't be a list (again)
      {10}     ; can't be an array (again)
      "10x     ; must be a number (again)
      10       ; legal
   ) []

   SIMPLEREPORTTEST [ POSXYZ ] [ 1 2 10 ]


   ; Test that SETX accepts ownership of any node :erract provides.
   LOCAL "erract
   TRACEINSTRUCTION [ MAKE "erract [ (WORD "- 5 ". 0) ] ]
   TRACEINSTRUCTIONNOCATCH [ SETZ [] ]
   SIMPLEREPORTTEST [ POSXYZ ] [ 1 2 -5 ]

   ; Back to the default mode.
   TRACEINSTRUCTION [ WRAP ]

END

TO XCORTEST.SMOKETEST

   TRACEINSTRUCTION [ HOME ]
   SIMPLEREPORTTEST [ XCOR ] 0

   TRACEINSTRUCTION [ SETPOSXYZ [ 51 52 53 ] ]
   SIMPLEREPORTTEST [ XCOR ] 51

   TRACEINSTRUCTION [ SETPOSXYZ [ -0.1 -0.2 -0.3 ] ]
   SIMPLEREPORTTEST [ XCOR ] -0.1

END

TO XCORTEST.BADINPUT
   ; bad number of inputs
   RUNTOOMANYINPUTSTEST [(XCOR "toomany)]
END


TO YCORTEST.SMOKETEST

   TRACEINSTRUCTION [ HOME ]
   SIMPLEREPORTTEST [ YCOR ] 0

   TRACEINSTRUCTION [ SETPOSXYZ [ 51 52 53 ] ]
   SIMPLEREPORTTEST [ YCOR ] 52

   TRACEINSTRUCTION [ SETPOSXYZ [ -0.1 -0.2 -0.3 ] ]
   SIMPLEREPORTTEST [ YCOR ] -0.2

END

TO YCORTEST.BADINPUT
   ; bad number of inputs
   RUNTOOMANYINPUTSTEST [(YCOR "toomany)]
END


TO ZCORTEST.SMOKETEST

   TRACEINSTRUCTION [ HOME ]
   SIMPLEREPORTTEST [ ZCOR ] 0

   TRACEINSTRUCTION [ PERSPECTIVE ]
   TRACEINSTRUCTION [ SETPOSXYZ [ 51 52 53 ] ]
   SIMPLEREPORTTEST [ ZCOR ] 53

   TRACEINSTRUCTION [ SETPOSXYZ [ -0.1 -0.2 -0.3 ] ]
   SIMPLEREPORTTEST [ ZCOR ] -0.299999

   TRACEINSTRUCTION [ WRAP ]

END

TO ZCORTEST.BADINPUT
   ; bad number of inputs
   RUNTOOMANYINPUTSTEST [(ZCOR "toomany)]
END


TO XYZTEST
   SETXYTEST.WRAP
   SETXYTEST.PERSPECTIVE
   SETXYTEST.BADINPUT
   SETXYTEST.BADINPUT.RECOVERABLE

   SETXYZTEST.WRAP
   SETXYZTEST.PERSPECTIVE
   SETXYZTEST.BADINPUT
   SETXYZTEST.BADINPUT.RECOVERABLE

   SETXTEST.WRAP
   SETXTEST.PERSPECTIVE
   SETXTEST.BADINPUT
   SETXTEST.BADINPUT.RECOVERABLE

   SETYTEST.WRAP
   SETYTEST.PERSPECTIVE
   SETYTEST.BADINPUT
   SETYTEST.BADINPUT.RECOVERABLE

   SETZTEST.WRAP
   SETZTEST.PERSPECTIVE
   SETZTEST.BADINPUT
   SETZTEST.BADINPUT.RECOVERABLE

   XCORTEST.SMOKETEST
   XCORTEST.BADINPUT

   YCORTEST.SMOKETEST
   YCORTEST.BADINPUT

   ZCORTEST.SMOKETEST
   ZCORTEST.BADINPUT
END

