LOAD "testlib.lgo

TO .EQTEST
  LOCALMAKE "x 1000
  LOCALMAKE "y 1000

  FAILIFNOTFALSE [.EQ 1000 1000]
  FAILIFNOTFALSE [.EQ :x   :y  ]
  FAILIFNOTTRUE  [.EQ :x   :x  ]

  ; test singleton objects that are globally unique
  FAILIFNOTTRUE [.EQ "||    "||    ]
  FAILIFNOTTRUE [.EQ "false "false ]
  FAILIFNOTTRUE [.EQ "true  "true  ]
  FAILIFNOTTRUE [.EQ []     []     ]

  RUNNOTENOUGHINPUTSTEST [(.EQ)]
  RUNNOTENOUGHINPUTSTEST [(.EQ 1)]
  RUNTOOMANYINPUTSTEST   [(.EQ 1 1 "toomany)]
END

TO EQUALPTEST.SMOKETEST

  LOCAL "CASEIGNOREDP ; default CASEIGNOREDP

  LOCAL "myarray
  FAILIFNOTTRUE [EQUALP 1    1                      ]
  FAILIFNOTTRUE [EQUALP 0    0                      ]
  FAILIFNOTTRUE [EQUALP 3.14 3.14                   ]
  FAILIFNOTTRUE [EQUALP "hi  "hi                    ]
  FAILIFNOTTRUE [EQUAL? ["a 1 "ab]    ["a 1 "ab]    ]
  FAILIFNOTTRUE [EQUAL? [[1 2 3] [1]] [[1 2 3] [1]] ]
  FAILIFNOTTRUE [EQUAL? 0 0                         ]
  FAILIFNOTTRUE [EQUALP "||  "||                    ]
  FAILIFNOTTRUE [EQUALP "true  "TRUE                ]
  FAILIFNOTTRUE [EQUALP "false "FALSE               ]
  FAILIFNOTTRUE [EQUALP "HELLO "hello               ]
  FAILIFNOTTRUE [EQUALP "hello "HELLO               ]
  FAILIFNOTTRUE [EQUALP "HELLO "HELLO               ]
  FAILIFNOTTRUE [EQUALP "hello "hello               ]

  MAKE "myarray {1 2 3}
  FAILIFNOTTRUE [EQUAL? :myarray :myarray           ]

  MAKE "myarray {}
  FAILIFNOTTRUE [EQUAL? :myarray :myarray           ]

  ; arrays are never equal to other arrays
  FAILIFNOTFALSE [EQUAL? {} {}                      ]
  FAILIFNOTFALSE [EQUAL? {1 2 3} {1 2 3}            ]

  FAILIFNOTFALSE [EQUALP 1       1.1                ]
  FAILIFNOTFALSE [EQUALP 0       1                  ]
  FAILIFNOTFALSE [EQUALP "hi     "hil               ]
  FAILIFNOTFALSE [EQUALP "hil    "hi                ]
  FAILIFNOTFALSE [EQUALP "true   "false             ]
  FAILIFNOTFALSE [EQUALP []      "false             ]
  FAILIFNOTFALSE [EQUALP "false  []                 ]
  FAILIFNOTFALSE [EQUALP [1 2]   [1 2 3]            ]
  FAILIFNOTFALSE [EQUALP [1 2 3] [1 2]              ]
  FAILIFNOTFALSE [EQUALP {1}     [1]                ]
  FAILIFNOTFALSE [EQUALP [1]     {1}                ]

  ; test the EQUALP infix operator
  FAILIFNOTTRUE [      1 = 1                   ]
  FAILIFNOTTRUE [      0 = 0                   ]
  FAILIFNOTTRUE [   3.14 = 3.14                ]
  FAILIFNOTTRUE [    "|| = "||                 ]
  FAILIFNOTTRUE [ "true  = "TRUE               ]
  FAILIFNOTTRUE [ "false = "FALSE              ]
  FAILIFNOTTRUE [ "HELLO = "hello              ]
  FAILIFNOTTRUE [ "hello = "HELLO              ]
  FAILIFNOTTRUE [ "HELLO = "HELLO              ]
  FAILIFNOTTRUE [ "hello = "hello              ]
  FAILIFNOTTRUE [["a 1 "ab]    = ["a 1 "ab]    ]
  FAILIFNOTTRUE [[[1 2 3] [1]] = [[1 2 3] [1]] ]

  ; very small floating point numbers are not equal to 0 (bug #289)
  FAILIFNOTFALSE [ EQUALP   1e-16      0  ]
  FAILIFNOTFALSE [ EQUALP  -1e-16      0  ]
  FAILIFNOTFALSE [ EQUALP    0      1e-16 ]
  FAILIFNOTFALSE [ EQUALP    0     -1e-16 ]

  ; now test case-sensitive comparisons
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP LOCALEFALSE]

  FAILIFNOTTRUE  [ EQUALP "HELLO "HELLO  ]
  FAILIFNOTTRUE  [ EQUALP "hello "hello  ]
  FAILIFNOTFALSE [ EQUALP "HELLO "hello  ]
  FAILIFNOTFALSE [ EQUALP "hello "HELLO  ]
  FAILIFNOTFALSE [ EQUALP "hello "hellox ]

  ; Even "true and "false obey the rules of caseignoredp
  FAILIFNOTTRUE  [ EQUALP "true  "true    ]
  FAILIFNOTTRUE  [ EQUALP "false "false   ]
  FAILIFNOTFALSE [ EQUALP "true  "TRUE    ]
  FAILIFNOTFALSE [ EQUALP "false "FALSE   ]
  FAILIFNOTFALSE [ EQUALP "true  "trueish ]

  ; Now test explicitly case-insensitive comparisons
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP LOCALETRUE]

  FAILIFNOTTRUE  [ EQUALP "HELLO "HELLO  ]
  FAILIFNOTTRUE  [ EQUALP "hello "hello  ]
  FAILIFNOTTRUE  [ EQUALP "HELLO "hello  ]
  FAILIFNOTTRUE  [ EQUALP "hello "HELLO  ]
  FAILIFNOTFALSE [ EQUALP "hello "hellox ]

  ; Even "true and "false obey the rules of caseignoredp
  FAILIFNOTTRUE  [ EQUALP "true  "true    ]
  FAILIFNOTTRUE  [ EQUALP "false "false   ]
  FAILIFNOTTRUE  [ EQUALP "true  "TRUE    ]
  FAILIFNOTTRUE  [ EQUALP "false "FALSE   ]
  FAILIFNOTFALSE [ EQUALP "true  "trueish ]

  ; Now test a non-boolean CASEIGNOREDP value.
  ; This should behave as if it were FALSE
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP 1]

  FAILIFNOTTRUE  [ EQUALP "HELLO "HELLO  ]
  FAILIFNOTTRUE  [ EQUALP "hello "hello  ]
  FAILIFNOTFALSE [ EQUALP "HELLO "hello  ]
  FAILIFNOTFALSE [ EQUALP "hello "HELLO  ]
  FAILIFNOTFALSE [ EQUALP "hello "hellox ]

END

TO EQUALPTEST.DEEPLYNESTEDLIST

  LOCALMAKE "nestedlist1 []
  REPEAT 50000 [ MAKE "nestedlist1 FPUT :nestedlist1 [] ]

  LOCALMAKE "nestedlist2 []
  REPEAT 50000 [ MAKE "nestedlist2 FPUT :nestedlist2 [] ]

  SIMPLEREPORTTEST [EQUALP :nestedlist1 :nestedlist2] "true
  
END

TO EQUALPTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(EQUAL?)]
  RUNNOTENOUGHINPUTSTEST [(EQUAL? 1)]
  RUNTOOMANYINPUTSTEST   [(EQUAL? 1 1 "toomany)]
END

TO EQUALPTEST.UNICODE

  ; Test uppercase/lowercase string comparisons for character 
  ; from Latin-1 Supplement (ones that are not in ASCII)

  ; NOTE: We don't put the literal characters so that this can continue
  ;       to be an ASCII file and will continue to look like a text file
  ;       to tools like grep and Subversion.  Instead we use their numeric
  ;       code points.
  local [pairs pair lowercase capital word1 word2]

  make "pairs [
    [225 193] ; LATIN [SMALL|CAPTIAL] LETTER A WITH ACUTE
    [226 194] ; LATIN [SMALL|CAPTIAL] LETTER A WITH CIRCUMFLEX
    [227 195] ; LATIN [SMALL|CAPTIAL] LETTER A WITH TILDE
    [228 196] ; LATIN [SMALL|CAPTIAL] LETTER A WITH DIAERESIS
    [231 199] ; LATIN [SMALL|CAPTIAL] LETTER C WITH CEDILLA
    [232 200] ; LATIN [SMALL|CAPTIAL] LETTER E WITH GRAVE
    [233 201] ; LATIN [SMALL|CAPTIAL] LETTER E WITH ACUTE
    [234 202] ; LATIN [SMALL|CAPTIAL] LETTER E WITH CIRCUMFLEX
    [235 203] ; LATIN [SMALL|CAPTIAL] LETTER E WITH DIAERESIS
    [236 204] ; LATIN [SMALL|CAPTIAL] LETTER I WITH GRAVE
    [237 205] ; LATIN [SMALL|CAPTIAL] LETTER I WITH ACUTE
    [238 206] ; LATIN [SMALL|CAPTIAL] LETTER I WITH CIRCUMFLEX
    [239 207] ; LATIN [SMALL|CAPTIAL] LETTER I WITH DIAERESIS
    [240 208] ; LATIN [SMALL|CAPTIAL] LETTER ETH
    [241 209] ; LATIN [SMALL|CAPTIAL] LETTER N WITH TILDE
    [243 211] ; LATIN [SMALL|CAPTIAL] LETTER O WITH ACUTE
    [244 212] ; LATIN [SMALL|CAPTIAL] LETTER O WITH CIRCUMFLEX
    [245 213] ; LATIN [SMALL|CAPTIAL] LETTER O WITH TILDE
    [246 214] ; LATIN [SMALL|CAPTIAL] LETTER O WITH DIAERESIS
    [248 216] ; LATIN [SMALL|CAPTIAL] LETTER O WITH STROKE
    [249 217] ; LATIN [SMALL|CAPTIAL] LETTER U WITH GRAVE
    [253 221] ; LATIN [SMALL|CAPTIAL] LETTER Y WITH ACUTE

    [945 913] ; GREEK [SMALL|CAPTITAL] LETTER ALPHA
    [974 911] ; GREEK [SMALL|CAPTITAL] LETTER OMEGA WITH TONOS

    ; equivalent charaters are equal although they don't differ by case
    [962 963] ; GREEK SMALL LETTER [FINAL|] SIGMA
  ]

  LOCAL "caseignoredp ; undefine :caseignoredp

  REPEAT COUNT :pairs [
     make "pair      ITEM REPCOUNT :pairs
     make "lowercase CHAR ITEM 1 :pair
     make "capital   CHAR ITEM 2 :pair

     make "word1 (WORD "" :lowercase :capital)
     make "word2 (WORD "" :capital   :lowercase)

     FAILIFNOTTRUE (LIST "EQUALP :word1 :word2)
  ]

  ; Run the same tests with :caseignoredp defined as true.
  MAKE "caseignoredp LOCALETRUE
  REPEAT COUNT :pairs [
     make "pair      ITEM REPCOUNT :pairs
     make "lowercase CHAR ITEM 1 :pair
     make "capital   CHAR ITEM 2 :pair

     make "word1 (WORD "" :lowercase :capital)
     make "word2 (WORD "" :capital   :lowercase)

     FAILIFNOTTRUE (LIST "EQUALP :word1 :word2)
  ]

  ; Run the same tests with :caseignoredp defined as false.
  ; In this case, the pairs are not equal.
  MAKE "caseignoredp LOCALEFALSE
  REPEAT COUNT :pairs [
     make "pair      ITEM REPCOUNT :pairs
     make "lowercase CHAR ITEM 1 :pair
     make "capital   CHAR ITEM 2 :pair

     make "word1 (WORD "" :lowercase :capital)
     make "word2 (WORD "" :capital   :lowercase)

     FAILIFNOTFALSE (LIST "EQUALP :word1 :word2)
  ]

END

TO EQUALPTEST
  EQUALPTEST.SMOKETEST
  ;EQUALPTEST.DEEPLYNESTEDLIST
  EQUALPTEST.UNICODE
  EQUALPTEST.BADINPUT
END

TO NOTEQUALPTEST.SMOKETEST

  LOCAL "CASEIGNOREDP ; default behavior

  LOCAL "myarray
  FAILIFNOTFALSE [NOTEQUALP 1    1                      ]
  FAILIFNOTFALSE [NOTEQUALP 0    0                      ]
  FAILIFNOTFALSE [NOTEQUALP 3.14 3.14                   ]
  FAILIFNOTFALSE [NOTEQUALP "hi  "hi                    ]
  FAILIFNOTFALSE [NOTEQUAL? ["a 1 "ab]    ["a 1 "ab]    ]
  FAILIFNOTFALSE [NOTEQUAL? [[1 2 3] [1]] [[1 2 3] [1]] ]
  FAILIFNOTFALSE [NOTEQUAL? 0 0                         ]
  FAILIFNOTFALSE [NOTEQUALP "||  "||                    ]
  FAILIFNOTFALSE [NOTEQUALP "true  "TRUE                ]
  FAILIFNOTFALSE [NOTEQUALP "false "FALSE               ]
  FAILIFNOTFALSE [NOTEQUALP "HELLO "hello               ]
  FAILIFNOTFALSE [NOTEQUALP "hello "HELLO               ]
  FAILIFNOTFALSE [NOTEQUALP "HELLO "HELLO               ]
  FAILIFNOTFALSE [NOTEQUALP "hello "hello               ]

  MAKE "myarray {1 2 3}
  FAILIFNOTFALSE [NOTEQUAL? :myarray :myarray ]

  MAKE "myarray {}
  FAILIFNOTFALSE [NOTEQUAL? :myarray :myarray ]

  ; arrays are never equal to other arrays
  FAILIFNOTTRUE [NOTEQUAL? {} {}              ]
  FAILIFNOTTRUE [NOTEQUAL? {1 2 3} {1 2 3}    ]

  FAILIFNOTTRUE [NOTEQUALP 1       1.1        ]
  FAILIFNOTTRUE [NOTEQUALP 0       1          ]
  FAILIFNOTTRUE [NOTEQUALP "hi     "hil       ]
  FAILIFNOTTRUE [NOTEQUALP "hil    "hi        ]
  FAILIFNOTTRUE [NOTEQUALP "true   "false     ]
  FAILIFNOTTRUE [NOTEQUALP []      "false     ]
  FAILIFNOTTRUE [NOTEQUALP "false  []         ]
  FAILIFNOTTRUE [NOTEQUALP [1 2]   [1 2 3]    ]
  FAILIFNOTTRUE [NOTEQUALP [1 2 3] [1 2]      ]
  FAILIFNOTTRUE [NOTEQUALP {1}     [1]        ]
  FAILIFNOTTRUE [NOTEQUALP [1]     {1}        ]

  ; test the NOTEQUALP infix operator
  FAILIFNOTFALSE [     1 <> 1                     ]
  FAILIFNOTFALSE [     0 <> 0                     ]
  FAILIFNOTFALSE [  3.14 <> 3.14                  ]
  FAILIFNOTFALSE [   "|| <> "||                   ]
  FAILIFNOTFALSE ["true  <> "TRUE                 ]
  FAILIFNOTFALSE ["false <> "FALSE                ]
  FAILIFNOTFALSE ["HELLO <> "hello                ]
  FAILIFNOTFALSE ["hello <> "HELLO                ]
  FAILIFNOTFALSE ["HELLO <> "HELLO                ]
  FAILIFNOTFALSE ["hello <> "hello                ]
  FAILIFNOTFALSE [ ["a 1 "ab]    <> ["a 1 "ab]    ]
  FAILIFNOTFALSE [ [[1 2 3] [1]] <> [[1 2 3] [1]] ]


  ; Now test explicitly case-sensitive comparisons
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP LOCALEFALSE]

  ; Even "true and "false obey the rules of caseignoredp
  FAILIFNOTFALSE [ NOTEQUALP "true  "true     ]
  FAILIFNOTFALSE [ NOTEQUALP "false "false    ]
  FAILIFNOTTRUE  [ NOTEQUALP "true  "TRUE     ]
  FAILIFNOTTRUE  [ NOTEQUALP "false "FALSE    ]
  FAILIFNOTTRUE  [ NOTEQUALP "false "falseish ]

  FAILIFNOTFALSE [ NOTEQUALP "HELLO "HELLO ]
  FAILIFNOTFALSE [ NOTEQUALP "hello "hello ]
  FAILIFNOTTRUE  [ NOTEQUALP "HELLO "hello ]
  FAILIFNOTTRUE  [ NOTEQUALP "hello "HELLO ]

  ; Now test explicitly case-insensitive comparisons
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP LOCALETRUE]

  FAILIFNOTFALSE [ NOTEQUALP "HELLO "HELLO  ]
  FAILIFNOTFALSE [ NOTEQUALP "hello "hello  ]
  FAILIFNOTFALSE [ NOTEQUALP "HELLO "hello  ]
  FAILIFNOTFALSE [ NOTEQUALP "hello "HELLO  ]
  FAILIFNOTTRUE  [ NOTEQUALP "HELLO "HELLOx ]

  ; Now test a non-boolean CASEIGNOREDP setting.
  ; This should behave the same as FALSE
  TRACEINSTRUCTION [MAKE "CASEIGNOREDP 1]

  FAILIFNOTFALSE [ NOTEQUALP "HELLO "HELLO ]
  FAILIFNOTFALSE [ NOTEQUALP "hello "hello ]
  FAILIFNOTTRUE  [ NOTEQUALP "HELLO "hello ]
  FAILIFNOTTRUE  [ NOTEQUALP "hello "HELLO ]

END

TO NOTEQUALPTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(NOTEQUAL?)]
  RUNNOTENOUGHINPUTSTEST [(NOTEQUAL? 1)]
  RUNTOOMANYINPUTSTEST   [(NOTEQUAL? 1 1 "toomany)]
END

TO NOTEQUALPTEST
  NOTEQUALPTEST.SMOKETEST
  NOTEQUALPTEST.BADINPUT
END

TO EMPTYPTEST
  FAILIFNOTTRUE  [EMPTYP [] ]
  FAILIFNOTTRUE  [EMPTY? [] ]
  FAILIFNOTFALSE [EMPTY? [1]]
  FAILIFNOTFALSE [EMPTY? [0]]
  FAILIFNOTFALSE [EMPTY? 0]
  FAILIFNOTTRUE  [EMPTY? "||]
  FAILIFNOTFALSE [EMPTY? "| |]

  FAILIFNOTFALSE [EMPTY? {}]

  RUNNOTENOUGHINPUTSTEST [(EMPTY?)]
  RUNTOOMANYINPUTSTEST   [(EMPTY? [] "toomany)]
END

TO NUMBERPTEST
  FAILIFNOTTRUE [NUMBERP 1      ]
  FAILIFNOTTRUE [NUMBER? 1      ]
  FAILIFNOTTRUE [NUMBER? 0      ]
  FAILIFNOTTRUE [NUMBER? -1     ]
  FAILIFNOTTRUE [NUMBER? 3.14   ]
  FAILIFNOTTRUE [NUMBER? "-1    ]
  FAILIFNOTTRUE [NUMBER? "0     ]
  FAILIFNOTTRUE [NUMBER? "-0    ]
  FAILIFNOTTRUE [NUMBER? "1     ]
  FAILIFNOTTRUE [NUMBER? "2     ]
  FAILIFNOTTRUE [NUMBER? "3     ]
  FAILIFNOTTRUE [NUMBER? "4     ]
  FAILIFNOTTRUE [NUMBER? "5     ]
  FAILIFNOTTRUE [NUMBER? "6     ]
  FAILIFNOTTRUE [NUMBER? "7     ]
  FAILIFNOTTRUE [NUMBER? "8     ]
  FAILIFNOTTRUE [NUMBER? "9     ]
  FAILIFNOTTRUE [NUMBER? "1e2   ]
  FAILIFNOTTRUE [NUMBER? "1E2   ]
  FAILIFNOTTRUE [NUMBER? "1e-1  ]
  FAILIFNOTTRUE [NUMBER? "1E-01 ]
  FAILIFNOTTRUE [NUMBER? "1.1e2 ]
  FAILIFNOTTRUE [NUMBER? ".1    ]
  FAILIFNOTTRUE [NUMBER? ".1e02 ]

  FAILIFNOTFALSE [NUMBER? "/] ; ASCII value just before '0'
  FAILIFNOTFALSE [NUMBER? ":] ; ASCII value just after  '0'
  FAILIFNOTFALSE [NUMBER? {}]
  FAILIFNOTFALSE [NUMBER? {2}]
  FAILIFNOTFALSE [NUMBER? []]
  FAILIFNOTFALSE [NUMBER? [1]]
  FAILIFNOTFALSE [NUMBER? "one]
  FAILIFNOTFALSE [NUMBER? "1A]
  FAILIFNOTFALSE [NUMBER? "A1]
  FAILIFNOTFALSE [NUMBER? "||]
  FAILIFNOTFALSE [NUMBER? CHAR 194 ] ; bug #342
  FAILIFNOTFALSE [NUMBER? "+9    ]
  FAILIFNOTFALSE [NUMBER? "0x20  ]
  FAILIFNOTFALSE [NUMBER? "20h   ]
  FAILIFNOTFALSE [NUMBER? "1e2e3 ]
  FAILIFNOTFALSE [NUMBER? "1.2.3 ]
  FAILIFNOTFALSE [NUMBER? "1..2  ]
  FAILIFNOTFALSE [NUMBER? "1ee2  ]

  RUNNOTENOUGHINPUTSTEST [(NUMBER?)]
  RUNTOOMANYINPUTSTEST   [(NUMBER? 1 "toomany)]
END

TO LISTPTEST
  FAILIFNOTTRUE [LISTP [1 2 3] ]
  FAILIFNOTTRUE [LIST? [1 2 3] ]
  FAILIFNOTTRUE [LIST? []      ]

  FAILIFNOTFALSE [LIST? "list  ]
  FAILIFNOTFALSE [LIST? "|[1]| ]
  FAILIFNOTFALSE [LIST? 1      ]
  FAILIFNOTFALSE [LIST? 3.14   ]
  FAILIFNOTFALSE [LIST? {1}    ]
  FAILIFNOTFALSE [LIST? {}     ]
  FAILIFNOTFALSE [LIST? "||    ]

  RUNNOTENOUGHINPUTSTEST [(LIST?)]
  RUNTOOMANYINPUTSTEST   [(LIST? [] "toomany)]
END

TO WORDPTEST
  FAILIFNOTTRUE [WORDP "hello ]
  FAILIFNOTTRUE [WORD? "hello ]
  FAILIFNOTTRUE [WORD? 123    ]
  FAILIFNOTTRUE [WORD? 3.14   ]
  FAILIFNOTTRUE [WORD? "||    ]
  FAILIFNOTTRUE [WORD? "|[1]| ]

  FAILIFNOTFALSE [WORD? []       ]
  FAILIFNOTFALSE [WORD? ["hello] ]
  FAILIFNOTFALSE [WORD? {}       ]
  FAILIFNOTFALSE [WORD? {"hello} ]

  RUNNOTENOUGHINPUTSTEST [(WORD?)]
  RUNTOOMANYINPUTSTEST   [(WORD? [] "toomany)]
END

TO ARRAYPTEST
  FAILIFNOTTRUE [ARRAYP {1 2 3} ]
  FAILIFNOTTRUE [ARRAY? {1 2 3} ]
  FAILIFNOTTRUE [ARRAY? {}      ]

  FAILIFNOTFALSE [ARRAY? "word  ]
  FAILIFNOTFALSE [ARRAY? "|{}|  ]
  FAILIFNOTFALSE [ARRAY? 1      ]
  FAILIFNOTFALSE [ARRAY? 3.14   ]
  FAILIFNOTFALSE [ARRAY? [1]    ]
  FAILIFNOTFALSE [ARRAY? []     ]
  FAILIFNOTFALSE [ARRAY? "||    ]

  RUNNOTENOUGHINPUTSTEST [(ARRAY?)]
  RUNTOOMANYINPUTSTEST   [(ARRAY? {1} "toomany)]
END

TO MEMBERPTEST
  FAILIFNOTTRUE  [MEMBERP 2 [1 2 3] ]
  FAILIFNOTTRUE  [MEMBER? 2 [1 2 3] ]

  FAILIFNOTTRUE  [MEMBER? 1   [1]           ]
  FAILIFNOTTRUE  [MEMBER? 1   [1 1 1]       ]
  FAILIFNOTFALSE [MEMBER? 0   [1 2 3]       ]
  FAILIFNOTTRUE  [MEMBER? [2] [[1] [2] [3]] ]
  FAILIFNOTFALSE [MEMBER? 2   [[1] [2] [3]] ]
  FAILIFNOTFALSE [MEMBER? [2] [1 2 3]       ]
  FAILIFNOTFALSE [MEMBER? 1   []            ]

  FAILIFNOTTRUE  [MEMBER? 1   {1}        ]
  FAILIFNOTTRUE  [MEMBER? 1   {1 1 1}    ]
  FAILIFNOTTRUE  [MEMBER? 12  {11 12 13} ]
  FAILIFNOTFALSE [MEMBER? 12  {}         ]

  FAILIFNOTTRUE  [MEMBER? 1   123  ]
  FAILIFNOTFALSE [MEMBER? 4   123  ]
  FAILIFNOTFALSE [MEMBER? 23  123  ]
  FAILIFNOTFALSE [MEMBER? 1   "||  ]
  FAILIFNOTFALSE [MEMBER? [1] "123 ]
  FAILIFNOTFALSE [MEMBER? {1} "123 ]

  FAILIFNOTFALSE [MEMBER? "|| "hello     ]
  FAILIFNOTTRUE  [MEMBER? "|| (LIST "||) ]
  FAILIFNOTFALSE [MEMBER? "ab "ab        ]

  LOCALMAKE "arrayofemptystring ARRAY 1
  SETITEM 1 :arrayofemptystring "||
  FAILIFNOTTRUE [MEMBER? "|| :arrayofemptystring ]

  ; No CASEIGNOREDP defined
  LOCAL "CASEIGNOREDP
  FAILIFNOTTRUE  [MEMBER? "a "a   ]
  FAILIFNOTTRUE  [MEMBER? "a "A   ]
  FAILIFNOTTRUE  [MEMBER? "A "a   ]
  FAILIFNOTTRUE  [MEMBER? "A "A   ]
  FAILIFNOTTRUE  [MEMBER? "a "abc ]
  FAILIFNOTTRUE  [MEMBER? "c "abc ]
  FAILIFNOTFALSE [MEMBER? "d "abc ]
  FAILIFNOTTRUE  [MEMBER? "A "abc ]
  FAILIFNOTTRUE  [MEMBER? "C "abc ]
  FAILIFNOTTRUE  [MEMBER? "a "ABC ]
  FAILIFNOTTRUE  [MEMBER? "c "ABC ]
  FAILIFNOTTRUE  [MEMBER? "A "ABC ]
  FAILIFNOTTRUE  [MEMBER? "C "ABC ]

  FAILIFNOTFALSE [MEMBER? "abc [a b c abcabc acb] ]
  FAILIFNOTTRUE  [MEMBER? "abc [ABC ABc abC]      ]
  FAILIFNOTTRUE  [MEMBER? "ABC [abc ABc abC]      ]
  FAILIFNOTTRUE  [MEMBER? "ABC [abc]              ]

  FAILIFNOTFALSE [MEMBER? "abc {a b c abcabc acb} ]
  FAILIFNOTTRUE  [MEMBER? "ABC {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}@100          ]
  FAILIFNOTTRUE  [MEMBER? "abc {ABC}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {ABC}              ]

  ; CASEIGNOREDP explicitly true (same as when not defined)
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "TRUE ]
  FAILIFNOTTRUE  [MEMBER? "a "a   ]
  FAILIFNOTTRUE  [MEMBER? "a "A   ]
  FAILIFNOTTRUE  [MEMBER? "A "a   ]
  FAILIFNOTTRUE  [MEMBER? "A "A   ]
  FAILIFNOTTRUE  [MEMBER? "a "abc ]
  FAILIFNOTTRUE  [MEMBER? "c "abc ]
  FAILIFNOTFALSE [MEMBER? "d "abc ]
  FAILIFNOTTRUE  [MEMBER? "A "abc ]
  FAILIFNOTTRUE  [MEMBER? "C "abc ]
  FAILIFNOTTRUE  [MEMBER? "a "ABC ]
  FAILIFNOTTRUE  [MEMBER? "c "ABC ]
  FAILIFNOTTRUE  [MEMBER? "A "ABC ]
  FAILIFNOTTRUE  [MEMBER? "C "ABC ]

  FAILIFNOTFALSE [MEMBER? "abc [a b c abcabc acb] ]
  FAILIFNOTTRUE  [MEMBER? "abc [ABC ABc abC]      ]
  FAILIFNOTTRUE  [MEMBER? "ABC [abc ABc abC]      ]
  FAILIFNOTTRUE  [MEMBER? "ABC [abc]              ]

  FAILIFNOTFALSE [MEMBER? "abc {a b c abcabc acb} ]
  FAILIFNOTTRUE  [MEMBER? "ABC {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}@100          ]
  FAILIFNOTTRUE  [MEMBER? "abc {ABC}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {ABC}              ]
  
  ; CASEIGNOREDP false
  TRACEINSTRUCTION [ MAKE "CASEIGNOREDP "FALSE ]
  FAILIFNOTTRUE  [MEMBER? "a "a   ]
  FAILIFNOTFALSE [MEMBER? "a "A   ]
  FAILIFNOTFALSE [MEMBER? "A "a   ]
  FAILIFNOTTRUE  [MEMBER? "A "A   ]
  FAILIFNOTTRUE  [MEMBER? "a "abc ]
  FAILIFNOTTRUE  [MEMBER? "c "abc ]
  FAILIFNOTFALSE [MEMBER? "d "abc ]
  FAILIFNOTFALSE [MEMBER? "A "abc ]
  FAILIFNOTFALSE [MEMBER? "C "abc ]
  FAILIFNOTFALSE [MEMBER? "a "ABC ]
  FAILIFNOTFALSE [MEMBER? "c "ABC ]
  FAILIFNOTTRUE  [MEMBER? "A "ABC ]
  FAILIFNOTTRUE  [MEMBER? "C "ABC ]

  FAILIFNOTFALSE [MEMBER? "abc [a b c abcabc acb] ]
  FAILIFNOTFALSE [MEMBER? "abc [ABC ABc abC]      ]
  FAILIFNOTFALSE [MEMBER? "ABC [abc ABc abC]      ]
  FAILIFNOTFALSE [MEMBER? "ABC [abc]              ]

  FAILIFNOTFALSE [MEMBER? "abc {a b c abcabc acb} ]
  FAILIFNOTFALSE [MEMBER? "ABC {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}              ]
  FAILIFNOTTRUE  [MEMBER? "abc {abc}@100          ]
  FAILIFNOTFALSE [MEMBER? "abc {ABC}              ]
  
  RUNNOTENOUGHINPUTSTEST [(MEMBER?)]
  RUNNOTENOUGHINPUTSTEST [(MEMBER? 1)]
  RUNTOOMANYINPUTSTEST   [(MEMBER? 2 [1 2 3] "toomany)]
END

TO BEFOREPTEST.SMOKETEST
  LOCALMAKE "CASEIGNOREDP LOCALETRUE

  FAILIFNOTTRUE  [BEFOREP "ABC "ABD ]
  FAILIFNOTTRUE  [BEFORE? "ABC "ABD ]
  FAILIFNOTFALSE [BEFORE? "ABD "ABC ]
  FAILIFNOTFALSE [BEFORE? "ABC "ABC ]

  FAILIFNOTTRUE  [BEFORE? "ABC  "ABCD ]
  FAILIFNOTFALSE [BEFORE? "ABCD "ABC  ]

  FAILIFNOTTRUE  [BEFORE? "||  "A]
  FAILIFNOTFALSE [BEFORE? "Z   "||]
 
  RUNNOTENOUGHINPUTSTEST [(BEFORE?)]
  RUNNOTENOUGHINPUTSTEST [(BEFORE? "ABC)]
  RUNBADINPUTTEST        [(BEFORE? "ABC [])]
  RUNBADINPUTTEST        [(BEFORE? []   "ABC)]
  RUNTOOMANYINPUTSTEST   [(BEFORE? "ABC "ABC "toomany)]
END

TO BEFOREPTEST.BADINPUT
  RUNNOTENOUGHINPUTSTEST [(BEFORE?)]
  RUNNOTENOUGHINPUTSTEST [(BEFORE? "ABC)]
  RUNBADINPUTTEST        [(BEFORE? "ABC [])]
  RUNBADINPUTTEST        [(BEFORE? []   "ABC)]
  RUNTOOMANYINPUTSTEST   [(BEFORE? "ABC "ABC "toomany)]
END

TO BEFOREPTEST.ORDERED :word1 :word2
  ; Runs BEFOREP in a way that logs the value of :word1 and :word2.
  ; Expects that :word1 is before :word2.
  FAILIFNOTTRUE  (LIST "BEFOREP WORD "" :word1 WORD "" :word2)
  FAILIFNOTFALSE (LIST "BEFOREP WORD "" :word2 WORD "" :word1)
END

TO BEFOREPTEST.EQUAL :word1 :word2
  ; Runs BEFOREP in a way that logs the value of :word1 and :word2.
  ; Expects that :word1 equals :word2.
  FAILIFNOTFALSE (LIST "BEFOREP WORD "" :word1 WORD "" :word2)
  FAILIFNOTFALSE (LIST "BEFOREP WORD "" :word2 WORD "" :word1)
END

TO BEFOREPTEST.UNICODE
  ; Test uppercase/lowercase string comparisons for some
  ; characters that are outside of the ASCII.

  ; NOTE: We don't put the literal characters so that this can continue
  ;       to be an ASCII file and will continue to look like a text file
  ;       to tools like grep and Subversion.  Instead we use their numeric
  ;       code points.
  LOCAL [
    upperAWithAcute lowerAWithAcute
    upperAlpha      lowerAlpha
    upperBeta       lowerBeta
    upperSigma      lowerSigma    lowerFinalSigma
  ]

  make "upperAWithAcute CHAR 193
  make "lowerAWithAcute CHAR 225

  make "upperAlpha CHAR 913
  make "lowerAlpha CHAR 945

  make "upperBeta  CHAR 914
  make "lowerBeta  CHAR 946

  make "upperSigma      CHAR 931
  make "lowerSigma      CHAR 962
  make "lowerFinalSigma CHAR 963

  LOCAL "caseignoredp ; undefine :caseignoredp

  ; when ignoring case, equal is not before
  BEFOREPTEST.EQUAL :upperAWithAcute :lowerAWithAcute
  BEFOREPTEST.EQUAL :upperAlpha      :lowerAlpha
  BEFOREPTEST.EQUAL :upperBeta       :lowerBeta
  BEFOREPTEST.EQUAL :upperSigma      :lowerSigma
  BEFOREPTEST.EQUAL :lowerSigma      :lowerFinalSigma

  ; The different latin A characters are ordered by diacritic marks.
  BEFOREPTEST.ORDERED "A :upperAWithAcute
  BEFOREPTEST.ORDERED "A :lowerAWithAcute
  BEFOREPTEST.ORDERED "a :upperAWithAcute
  BEFOREPTEST.ORDERED "a :lowerAWithAcute
  BEFOREPTEST.ORDERED :upperAWithAcute "B
  BEFOREPTEST.ORDERED :lowerAWithAcute "B
  BEFOREPTEST.ORDERED :upperAWithAcute "b
  BEFOREPTEST.ORDERED :lowerAWithAcute "b

  ; Alpha is before Beta (all cases)
  BEFOREPTEST.ORDERED :upperAlpha :upperBeta
  BEFOREPTEST.ORDERED :lowerAlpha :upperBeta
  BEFOREPTEST.ORDERED :upperAlpha :lowerBeta
  BEFOREPTEST.ORDERED :lowerAlpha :lowerBeta

  ; All Latin characters are before all Greek characters
  BEFOREPTEST.ORDERED "Z :upperAlpha
  BEFOREPTEST.ORDERED "Z :lowerAlpha

  ; Run the same tests with :caseignoredp defined as false.
  ; Now the upper-case characters are less than the lower-case characters.
  TRACEINSTRUCTION [ MAKE "caseignoredp LOCALEFALSE ]
  BEFOREPTEST.ORDERED :upperAWithAcute :lowerAWithAcute
  BEFOREPTEST.ORDERED "z               :upperAWithAcute
  BEFOREPTEST.ORDERED "z               :lowerAWithAcute
  BEFOREPTEST.ORDERED :upperAlpha      :lowerAlpha
  BEFOREPTEST.ORDERED :upperBeta       :lowerBeta
  BEFOREPTEST.ORDERED :upperSigma      :lowerSigma
  BEFOREPTEST.ORDERED :lowerSigma      :lowerFinalSigma

END

TO BEFOREPTEST
  BEFOREPTEST.SMOKETEST
  BEFOREPTEST.BADINPUT
  BEFOREPTEST.UNICODE
END

TO PREDICATETEST

  .EQTEST
  EQUALPTEST
  NOTEQUALPTEST

  EMPTYPTEST
  NUMBERPTEST
  LISTPTEST
  WORDPTEST  
  ARRAYPTEST
  MEMBERPTEST
  BEFOREPTEST
END
